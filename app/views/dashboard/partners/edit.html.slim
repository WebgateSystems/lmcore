- content_for(:page_title) { "Edit Partner" }

section
  .d-flex.justify-content-between.align-items-center.mb-4
    div
    .dashboard-actions
      = link_to t("dashboard.partners.index.back"), dashboard_partners_path, class: "btn-dashboard-secondary"
      = button_to dashboard_partner_path(@partner), method: :delete, class: "btn-dashboard-danger", data: { turbo_confirm: t("dashboard.common.confirm_delete") } do
        = t("dashboard.common.delete")

  = render "form", partner: @partner
