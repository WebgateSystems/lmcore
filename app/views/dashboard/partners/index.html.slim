- content_for(:page_title) { "Partners" }

section
  .d-flex.justify-content-between.align-items-center.mb-4
    div
    = link_to t("dashboard.partners.index.new"), new_dashboard_partner_path, class: "btn-dashboard-primary"

  - if @partners.any?
    .panel
      table.dashboard-table
        thead
          tr
            th style="width:50px" #
            th = t("dashboard.common.table.logo")
            th = t("dashboard.common.table.name")
            th = t("dashboard.common.table.url")
            th = t("dashboard.common.table.status")
            th.text-end = t("dashboard.common.table.actions")
        tbody#partners-tbody
          - @partners.each do |partner|
            tr.sortable-row data-partner-id=partner.id draggable="true"
              td.sortable-handle style="cursor:move;user-select:none"
                i.bi.bi-grip-vertical style="font-size:18px;color:var(--content-tertiary)"
              td
                - if partner.logo_svg.present?
                  span style="display:inline-block;max-width:48px;max-height:32px;overflow:hidden" == partner.logo_svg
                - elsif partner.logo_url.present?
                  img src=partner.logo_url alt=partner.name style="max-width:48px;max-height:32px;object-fit:contain"
                - elsif partner.icon_class.present?
                  i class=partner.icon_class style="font-size:24px"
                - else
                  span.text-muted = t("dashboard.common.none")
              td = link_to partner.name, edit_dashboard_partner_path(partner), class: "text-decoration-none fw-medium"
              td
                - if partner.url.present?
                  = link_to partner.url.truncate(35), partner.url, target: "_blank", class: "text-body-3"
                - else
                  = t("dashboard.common.none")
              td
                - if partner.active?
                  span.dashboard-badge.dashboard-badge--published = t("dashboard.common.active")
                - else
                  span.dashboard-badge.dashboard-badge--draft = t("dashboard.common.inactive")
              td.text-end
                .dashboard-actions.justify-content-end
                  = link_to edit_dashboard_partner_path(partner), class: "icon-pill", title: t("dashboard.common.edit") do
                    i.bi.bi-pencil
                  = button_to dashboard_partner_path(partner), method: :delete, class: "icon-pill text-danger", title: t("dashboard.common.delete"), data: { turbo_confirm: t("dashboard.common.confirm_delete") } do
                    i.bi.bi-trash

  - else
    .dashboard-empty
      i.bi.bi-people
      p = t("dashboard.partners.index.empty")
      = link_to t("dashboard.partners.index.empty_cta"), new_dashboard_partner_path, class: "btn-dashboard-primary"

javascript:
  document.addEventListener('DOMContentLoaded', function() {
    const saveOrderFailed = #{t("dashboard.common.save_order_failed").to_json};
    const tbody = document.getElementById('partners-tbody');
    if (!tbody) return;

    let draggedRow = null;
    const rows = tbody.querySelectorAll('tr[data-partner-id]');

    rows.forEach(function(row) {
      row.addEventListener('dragstart', function(e) {
        draggedRow = this;
        this.classList.add('dragging');
        this.style.opacity = '0.4';
      });
      row.addEventListener('dragend', function() {
        this.classList.remove('dragging');
        this.style.opacity = '';
        tbody.querySelectorAll('tr').forEach(function(r) { r.classList.remove('drag-over'); });
      });
      row.addEventListener('dragover', function(e) {
        e.preventDefault();
        if (draggedRow !== this) this.classList.add('drag-over');
      });
      row.addEventListener('dragleave', function() {
        this.classList.remove('drag-over');
      });
      row.addEventListener('drop', function(e) {
        e.stopPropagation();
        if (draggedRow !== this) {
          var rect = this.getBoundingClientRect();
          var insertBefore = e.clientY < rect.top + rect.height / 2;
          if (insertBefore) tbody.insertBefore(draggedRow, this);
          else tbody.insertBefore(draggedRow, this.nextSibling);
          saveOrder();
        }
        this.classList.remove('drag-over');
      });
    });

    function saveOrder() {
      var partnerIds = Array.from(tbody.querySelectorAll('tr[data-partner-id]')).map(function(r) {
        return r.dataset.partnerId;
      });
      var csrfToken = document.querySelector('meta[name="csrf-token"]');
      fetch('#{reorder_dashboard_partners_path}', {
        method: 'POST',
        headers: {
          'X-CSRF-Token': csrfToken ? csrfToken.content : '',
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ partner_ids: partnerIds }),
        credentials: 'same-origin'
      }).then(function(response) {
        if (!response.ok) {
          alert(saveOrderFailed);
          window.location.reload();
        }
      }).catch(function() {
        alert(saveOrderFailed);
        window.location.reload();
      });
    }
  });

css:
  .sortable-row { transition: background-color 0.2s ease; }
  .sortable-row.dragging { opacity: 0.3; background-color: var(--surface-hover, #f5f5f5); }
  .sortable-row.drag-over { background-color: var(--surface-hover, #f0f0f0); }
  .sortable-handle { cursor: move; user-select: none; }
