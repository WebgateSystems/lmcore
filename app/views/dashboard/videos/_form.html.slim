- video_provider_options = %w[youtube vimeo self_hosted].map { |key| [t("dashboard.videos.provider_options.#{key}"), key] }
- locales = dashboard_available_locales.presence || I18n.available_locales.map(&:to_s)
- locales = locales.map(&:to_s)
- active_locale = locales.include?(I18n.locale.to_s) ? I18n.locale.to_s : locales.first
= form_with(model: [:dashboard, video], class: "dashboard-form") do |f|
  - if video.errors.any?
    .alert.alert-danger
      ul.mb-0
        - video.errors.full_messages.each do |msg|
          li = msg

  = render "dashboard/shared/i18n_legend"

  .post-editor data-locale-switcher="" data-active-locale=active_locale
    .post-editor__tabs role="tablist"
      - locales.each do |loc|
        button.post-editor__tab type="button" data-locale-tab=loc class=(loc == active_locale ? "active" : "")
          = locale_native_name(loc)
          span.text-muted.ms-1.small = "(#{locale_ui_tag(loc)})"

    - locales.each do |loc|
      - panel_classes = ["post-editor__panel"]
      - panel_classes << "d-none" unless loc == active_locale
      .post-editor__panel class=panel_classes.join(" ") data-locale-panel=loc
        .mb-3
          = label_tag "video_title_i18n_#{loc}", t("dashboard.common.table.title"), class: "form-label form-label--translatable"
          = text_field_tag "video[title_i18n][#{loc}]", video.title_i18n&.dig(loc), class: "form-control", placeholder: t("dashboard.videos.form.title_placeholder")

        .mb-3
          = label_tag "video_subtitle_i18n_#{loc}", t("dashboard.photos.form.excerpt"), class: "form-label form-label--translatable"
          = text_area_tag "video[subtitle_i18n][#{loc}]", video.subtitle_i18n&.dig(loc), class: "form-control", rows: 3, placeholder: t("dashboard.videos.form.excerpt_placeholder")

        .mb-3
          = label_tag "video_description_i18n_#{loc}", t("dashboard.videos.form.description"), class: "form-label form-label--translatable"
          = text_area_tag "video[description_i18n][#{loc}]", video.description_i18n&.dig(loc), class: "form-control", rows: 10, placeholder: t("dashboard.videos.form.description_placeholder")

  .mb-3
    = f.label :slug, t("dashboard.common.table.slug"), class: "form-label"
    = f.text_field :slug, class: "form-control", placeholder: t("dashboard.videos.form.slug_placeholder")

  .row
    .col-md-6.mb-3
      = f.label :video_url, t("dashboard.videos.form.video_url"), class: "form-label"
      = f.url_field :video_url, class: "form-control", placeholder: t("dashboard.videos.form.video_url_placeholder")
    .col-md-6.mb-3
      = f.label :video_provider, t("dashboard.videos.form.provider"), class: "form-label"
      = f.select :video_provider, video_provider_options, { include_blank: t("dashboard.videos.form.provider_blank") }, class: "form-select"

  .mb-3
    = f.label :thumbnail, t("dashboard.common.table.thumbnail", default: "Thumbnail"), class: "form-label"
    - if video.thumbnail.present?
      .mb-2
        = image_tag(video.thumbnail.url, class: "img-fluid rounded", style: "max-height: 180px;", alt: video.title.to_s)
    - else
      .mb-2
        = image_tag("/images/fallback/video_thumbnail.png", class: "img-fluid rounded opacity-50", style: "max-height: 180px;", alt: video.title.to_s)
    = f.file_field :thumbnail, class: "form-control", accept: "image/*"

  .row
    .col-md-6.mb-3
      = f.label :category_id, t("dashboard.videos.form.category"), class: "form-label"
      = f.collection_select :category_id, @categories, :id, :name, { include_blank: t("dashboard.videos.form.no_category") }, class: "form-select"
    .col-md-6.mb-3
      = f.label :status, t("dashboard.videos.form.status"), class: "form-label"
      = f.select :status, Video.aasm.states.map { |s| [s.name.to_s.humanize, s.name] }, {}, class: "form-select"

  .mb-3
    = f.label :published_at, t("dashboard.videos.form.published_at"), class: "form-label"
    = f.datetime_local_field :published_at, class: "form-control"

  .dashboard-actions
    = f.submit video.persisted? ? t("dashboard.videos.form.update") : t("dashboard.videos.form.create"), class: "btn-dashboard-primary"
    = link_to t("dashboard.common.cancel"), dashboard_videos_path, class: "btn-dashboard-secondary"
