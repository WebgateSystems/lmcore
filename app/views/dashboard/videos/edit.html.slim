- content_for(:page_title) { "Edit Video" }

section
  .d-flex.justify-content-between.align-items-center.mb-4
    div
    .dashboard-actions
      = link_to t("dashboard.videos.index.back"), dashboard_videos_path, class: "btn-dashboard-secondary"
      = button_to dashboard_video_path(@video), method: :delete, class: "btn-dashboard-danger", data: { turbo_confirm: t("dashboard.common.confirm_delete") } do
        = t("dashboard.common.delete")

  = render "form", video: @video
