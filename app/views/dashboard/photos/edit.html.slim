- content_for(:page_title) { "Edit Photo" }

section
  .d-flex.justify-content-between.align-items-center.mb-4
    div
    .dashboard-actions
      = link_to t("dashboard.photos.form.back_to_list"), dashboard_photos_path, class: "btn-dashboard-secondary"
      = button_to dashboard_photo_path(@photo), method: :delete, class: "btn-dashboard-danger", data: { turbo_confirm: t("dashboard.photos.form.delete_confirm") } do
        = t("dashboard.photos.form.delete")

  = render "form", photo: @photo
