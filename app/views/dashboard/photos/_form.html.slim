= form_with(model: [:dashboard, photo], class: "dashboard-form") do |f|
  - if photo.errors.any?
    .alert.alert-danger
      ul.mb-0
        - photo.errors.full_messages.each do |msg|
          li = msg

  = render "dashboard/shared/i18n_legend"

  p.form-text.small.mb-3 = t("dashboard.photos.form.required_hint")

  .mb-3
    = f.label :image, class: "form-label" do
      = t("dashboard.photos.form.image")
      span.text-danger.ms-1 *
    = f.file_field :image, class: "form-control", accept: "image/*", required: !photo.persisted?
    - if photo.persisted? && photo.image.present?
      .mt-2
        = image_tag photo.image.thumb.url, class: "img-thumbnail", style: "max-height:160px"

  .mb-3
    = f.label :title, class: "form-label form-label--translatable" do
      = t("dashboard.photos.form.title")
      span.form-label__locale = " (#{locale_ui_tag})"
      span.text-muted.ms-1.small = "(#{t('dashboard.photos.form.optional')})"
    = f.text_field :title, class: "form-control", placeholder: t("dashboard.photos.form.title_placeholder")

  .mb-3
    = f.label :slug, class: "form-label" do
      = t("dashboard.photos.form.slug")
      span.text-muted.ms-1.small = "(#{t('dashboard.photos.form.optional')})"
    = f.text_field :slug, class: "form-control", placeholder: t("dashboard.photos.form.slug_placeholder")

  .mb-3
    = f.label :alt_text, class: "form-label form-label--translatable" do
      = t("dashboard.photos.form.alt_text")
      span.form-label__locale = " (#{locale_ui_tag})"
      span.text-muted.ms-1.small = "(#{t('dashboard.photos.form.optional')})"
    = f.text_field :alt_text, class: "form-control", placeholder: t("dashboard.photos.form.alt_text_placeholder")

  .mb-3
    = f.label :description, class: "form-label form-label--translatable" do
      = t("dashboard.photos.form.description")
      span.form-label__locale = " (#{locale_ui_tag})"
      span.text-muted.ms-1.small = "(#{t('dashboard.photos.form.optional')})"
    = f.text_area :description, class: "form-control", rows: 8, placeholder: t("dashboard.photos.form.description_placeholder")

  .row
    .col-md-6.mb-3
      = f.label :category_id, class: "form-label" do
        = t("dashboard.photos.form.category")
        span.text-muted.ms-1.small = "(#{t('dashboard.photos.form.optional')})"
      = f.collection_select :category_id, @categories, :id, :name, { include_blank: t("dashboard.photos.form.no_category") }, class: "form-select"
    .col-md-6.mb-3
      = f.label :status, t("dashboard.photos.form.status"), class: "form-label"
      = f.select :status, Photo.aasm.states.map { |s| [s.name.to_s.humanize, s.name] }, {}, class: "form-select"

  .mb-3
    = f.label :published_at, t("dashboard.photos.form.published_at"), class: "form-label"
    = f.date_field :published_at, class: "form-control", value: (photo.published_at&.to_date || Date.current)

  .dashboard-actions
    = f.submit photo.persisted? ? t("dashboard.photos.form.update") : t("dashboard.photos.form.create"), class: "btn-dashboard-primary"
    = link_to t("dashboard.photos.form.cancel"), dashboard_photos_path, class: "btn-dashboard-secondary"
