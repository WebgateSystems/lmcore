= form_with(model: [:dashboard, post], class: "dashboard-form") do |f|
  - current_locale = I18n.locale.to_s
  - label_locale = (LocaleTags.canonical_locale_code(current_locale).presence || current_locale).to_sym
  - label_i18n = { locale: label_locale, lang: locale_ui_tag(current_locale) }
  - if post.errors.any?
    .alert.alert-danger
      ul.mb-0
        - post.errors.full_messages.each do |msg|
          li = msg

  = render "dashboard/shared/i18n_legend"

  .mb-3
    = label_tag "post_title_i18n_#{current_locale}", t("dashboard.posts.form.title", **label_i18n), class: "form-label form-label--translatable"
    = text_field_tag "post[title_i18n][#{current_locale}]", post.title_i18n&.dig(current_locale), class: "form-control", placeholder: t("dashboard.posts.form.title_placeholder")

  .mb-3
    = label_tag "post_subtitle_i18n_#{current_locale}", t("dashboard.posts.form.subtitle", **label_i18n), class: "form-label form-label--translatable"
    = text_field_tag "post[subtitle_i18n][#{current_locale}]", post.subtitle_i18n&.dig(current_locale), class: "form-control", placeholder: t("dashboard.posts.form.subtitle_placeholder")

  .mb-3
    = f.label :slug, class: "form-label"
    = f.text_field :slug, class: "form-control", placeholder: t("dashboard.posts.form.slug_placeholder")

  .mb-3
    = label_tag "post_lead_i18n_#{current_locale}", t("dashboard.posts.form.lead", **label_i18n), class: "form-label form-label--translatable"
    = text_area_tag "post[lead_i18n][#{current_locale}]", post.lead_i18n&.dig(current_locale), class: "form-control", rows: 3, placeholder: t("dashboard.posts.form.lead_placeholder")

  .mb-3
    = label_tag "post_content_i18n_#{current_locale}", t("dashboard.posts.form.content", **label_i18n), class: "form-label form-label--translatable"
    = text_area_tag "post[content_i18n][#{current_locale}]", post.content_i18n&.dig(current_locale), class: "form-control", rows: 15, placeholder: t("dashboard.posts.form.content_placeholder")

  .row
    .col-md-6.mb-3
      = f.label :category_id, t("dashboard.posts.form.category"), class: "form-label"
      = f.collection_select :category_id, @categories, :id, :name, { include_blank: t("dashboard.posts.form.no_category") }, class: "form-select"
    .col-md-6.mb-3
      = f.label :status, t("dashboard.posts.form.status"), class: "form-label"
      = f.select :status, Post.aasm.states.map { |s| [s.name.to_s.humanize, s.name] }, {}, class: "form-select"

  .row
    .col-md-6.mb-3
      = label_tag "post_keywords_i18n_#{current_locale}", t("dashboard.posts.form.seo_keywords", **label_i18n), class: "form-label form-label--translatable"
      = text_field_tag "post[keywords_i18n][#{current_locale}]", post.keywords_i18n&.dig(current_locale), class: "form-control", placeholder: t("dashboard.posts.form.seo_keywords_placeholder")
    .col-md-6.mb-3
      = label_tag "post_meta_description_i18n_#{current_locale}", t("dashboard.posts.form.seo_description", **label_i18n), class: "form-label form-label--translatable"
      = text_field_tag "post[meta_description_i18n][#{current_locale}]", post.meta_description_i18n&.dig(current_locale), class: "form-control", placeholder: t("dashboard.posts.form.seo_description_placeholder")

  .mb-3
    = f.label :published_at, t("dashboard.posts.form.published_at"), class: "form-label"
    = f.datetime_local_field :published_at, class: "form-control"

  .dashboard-actions
    = f.submit post.persisted? ? t("dashboard.posts.form.update") : t("dashboard.posts.form.create"), class: "btn-dashboard-primary"
    = link_to t("dashboard.common.cancel"), dashboard_posts_path, class: "btn-dashboard-secondary"
