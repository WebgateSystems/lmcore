- content_for(:page_title) { "Edit Post" }

section
  .d-flex.justify-content-between.align-items-center.mb-4
    div
    .dashboard-actions
      = link_to t("dashboard.posts.index.back"), dashboard_posts_path, class: "btn-dashboard-secondary"
      = button_to dashboard_post_path(@post), method: :delete, class: "btn-dashboard-danger", data: { turbo_confirm: t("dashboard.common.confirm_delete") } do
        = t("dashboard.common.delete")

  = render "form", post: @post
