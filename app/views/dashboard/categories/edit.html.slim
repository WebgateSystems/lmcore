- content_for(:page_title) { "Edit Category" }

section
  .d-flex.justify-content-between.align-items-center.mb-4
    div
    .dashboard-actions
      = link_to t("dashboard.categories.index.back"), dashboard_categories_path, class: "btn-dashboard-secondary"
      = button_to dashboard_category_path(@category), method: :delete, class: "btn-dashboard-danger", data: { turbo_confirm: t("dashboard.common.confirm_delete") } do
        = t("dashboard.common.delete")

  = render "form", category: @category
