- category_type_options = %w[general posts videos photos].map { |k| [t("dashboard.categories.types.#{k}"), k] }
= form_with(model: [:dashboard, category], class: "dashboard-form") do |f|
  - if category.errors.any?
    .alert.alert-danger
      ul.mb-0
        - category.errors.full_messages.each do |msg|
          li = msg

  = render "dashboard/shared/i18n_legend"

  .mb-3
    = f.label :name, class: "form-label form-label--translatable" do
      = t("dashboard.common.table.name")
      span.form-label__locale = " (#{locale_ui_tag})"
    = f.text_field :name, class: "form-control", placeholder: t("dashboard.categories.form.name_placeholder")

  .mb-3
    = f.label :slug, t("dashboard.common.table.slug"), class: "form-label"
    = f.text_field :slug, class: "form-control", placeholder: t("dashboard.categories.form.slug_placeholder")

  .mb-3
    = f.label :description, class: "form-label form-label--translatable" do
      = t("dashboard.settings.description")
      span.form-label__locale = " (#{locale_ui_tag})"
    = f.text_area :description, class: "form-control", rows: 3, placeholder: t("dashboard.categories.form.description_placeholder")

  .row
    .col-md-6.mb-3
      = f.label :parent_id, t("dashboard.categories.form.parent"), class: "form-label"
      = f.collection_select :parent_id, @parent_categories, :id, :name, { include_blank: t("dashboard.categories.form.no_parent") }, class: "form-select"
    .col-md-6.mb-3
      = f.label :category_type, t("dashboard.categories.form.category_type"), class: "form-label"
      = f.select :category_type, category_type_options, {}, class: "form-select"

  .mb-3
    = f.label :position, t("dashboard.categories.form.position"), class: "form-label"
    = f.number_field :position, class: "form-control", placeholder: t("dashboard.categories.form.position_placeholder")

  .dashboard-actions
    = f.submit category.persisted? ? t("dashboard.categories.form.update") : t("dashboard.categories.form.create"), class: "btn-dashboard-primary"
    = link_to t("dashboard.common.cancel"), dashboard_categories_path, class: "btn-dashboard-secondary"
