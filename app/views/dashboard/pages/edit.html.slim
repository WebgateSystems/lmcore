- content_for(:page_title) { "Edit Page" }

section
  .d-flex.justify-content-between.align-items-center.mb-4
    div
    .dashboard-actions
      = link_to t("dashboard.pages.index.back"), dashboard_pages_path, class: "btn-dashboard-secondary"
      = button_to dashboard_page_path(@page), method: :delete, class: "btn-dashboard-danger", data: { turbo_confirm: t("dashboard.common.confirm_delete") } do
        = t("dashboard.common.delete")

  = render "form", page: @page
