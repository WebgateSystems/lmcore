- content_for(:page_title) { "Edit Tag" }

section
  .d-flex.justify-content-between.align-items-center.mb-4
    div
    .dashboard-actions
      = link_to t("dashboard.tags.index.back"), dashboard_tags_path, class: "btn-dashboard-secondary"
      = button_to dashboard_tag_path(@tag), method: :delete, class: "btn-dashboard-danger", data: { turbo_confirm: t("dashboard.common.confirm_delete") } do
        = t("dashboard.common.delete")

  = render "form", tag: @tag
