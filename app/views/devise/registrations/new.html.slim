- content_for :title, t('auth.sign_up')
- oauth_provider_keys = Devise.omniauth_configs.keys.map(&:to_s)
- has_social_oauth = (%w[apple google_oauth2 facebook] & oauth_provider_keys).any?

h2.auth-title= t('auth.sign_up')

- invitation_token = params[:invitation_token].presence

- if @pending_invitation
  .auth-alert.auth-alert-info
    i.fa-solid.fa-envelope-open-text
    span = t('auth.invitation_intro', email: @pending_invitation.email)

= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: 'auth-form' }) do |f|
  - if invitation_token
    = hidden_field_tag :invitation_token, invitation_token

  - if resource.errors.any?
    .auth-alert.auth-alert-error
      i.fa-solid.fa-circle-exclamation
      span= resource.errors.full_messages.first

  .form-row-2
    .form-group
      = f.label :first_name, t('activerecord.attributes.user.first_name')
      .input-wrapper
        i.fa-solid.fa-user.input-icon
        = f.text_field :first_name, class: 'form-input', autofocus: true, placeholder: t('activerecord.attributes.user.first_name')

    .form-group
      = f.label :last_name, t('activerecord.attributes.user.last_name')
      .input-wrapper
        i.fa-solid.fa-user.input-icon
        = f.text_field :last_name, class: 'form-input', placeholder: t('activerecord.attributes.user.last_name')

  .form-group
    = f.label :username, t('activerecord.attributes.user.username')
    .input-wrapper
      i.fa-solid.fa-at.input-icon
      = f.text_field :username, class: 'form-input', autocomplete: 'username', placeholder: 'username'

  .form-group
    = f.label :email, t('auth.email')
    .input-wrapper
      i.fa-solid.fa-envelope.input-icon
      = f.email_field :email, class: 'form-input', autocomplete: 'email', placeholder: 'email@example.com'

  .form-group
    = f.label :password, t('auth.password')
    .input-wrapper
      i.fa-solid.fa-lock.input-icon
      = f.password_field :password, class: 'form-input', autocomplete: 'new-password', placeholder: '••••••••'
    - if @minimum_password_length
      p.form-hint= t('devise.registrations.new.minimum_password_length', count: @minimum_password_length)

  .form-group
    = f.label :password_confirmation, t('auth.password_confirmation')
    .input-wrapper
      i.fa-solid.fa-lock.input-icon
      = f.password_field :password_confirmation, class: 'form-input', autocomplete: 'new-password', placeholder: '••••••••'

  .form-actions
    = f.submit t('auth.sign_up'), class: 'btn btn-primary btn-lg btn-block'

  .auth-divider
    span= t('common.or')

  .auth-footer-text
    span.text-muted= t('auth.have_account')
    = link_to t('auth.sign_in'), new_session_path(resource_name), class: 'auth-link auth-link-bold'

- if has_social_oauth
  .auth-divider
    span= t('auth.or_continue_with', default: 'or Continue with')

  .social-auth data-turbo="false"
    - if oauth_provider_keys.include?("apple")
      form.social-auth__provider-form action="/auth/apple" method="post" target="_top" data-turbo="false" data-turbo-frame="_top"
        input type="hidden" name="authenticity_token" value=form_authenticity_token
        button.social-auth__provider-btn type="submit" aria-label=t('auth.sign_up_with_apple', default: 'Sign up with Apple')
          i.fa-brands.fa-apple
    - if oauth_provider_keys.include?("google_oauth2")
      form.social-auth__provider-form action="/auth/google_oauth2" method="post" target="_top" data-turbo="false" data-turbo-frame="_top"
        input type="hidden" name="authenticity_token" value=form_authenticity_token
        button.social-auth__provider-btn type="submit" aria-label=t('auth.sign_up_with_google', default: 'Sign up with Google')
          i.fa-brands.fa-google
    - if oauth_provider_keys.include?("facebook")
      form.social-auth__provider-form action="/auth/facebook" method="post" target="_top" data-turbo="false" data-turbo-frame="_top"
        input type="hidden" name="authenticity_token" value=form_authenticity_token
        button.social-auth__provider-btn type="submit" aria-label=t('auth.sign_up_with_facebook', default: 'Sign up with Facebook')
          i.fa-brands.fa-facebook
