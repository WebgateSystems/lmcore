- content_for :title, t('auth.sign_in')
- oauth_provider_keys = Devise.omniauth_configs.keys.map(&:to_s)
- has_social_oauth = (%w[apple google_oauth2 facebook] & oauth_provider_keys).any?

h2.auth-title= t('auth.sign_in')

= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'auth-form' }) do |f|
  - if flash[:alert]
    .auth-alert.auth-alert-error
      i.fa-solid.fa-circle-exclamation
      span= flash[:alert]

  .form-group
    = f.label :email, t('auth.email')
    .input-wrapper
      i.fa-solid.fa-envelope.input-icon
      = f.email_field :email, class: 'form-input', autofocus: true, autocomplete: 'email', placeholder: 'email@example.com'

  .form-group
    = f.label :password, t('auth.password')
    .input-wrapper
      i.fa-solid.fa-lock.input-icon
      = f.password_field :password, class: 'form-input', autocomplete: 'current-password', placeholder: '••••••••'

  .form-row
    .form-check
      = f.check_box :remember_me, class: 'form-checkbox'
      = f.label :remember_me, t('auth.remember_me'), class: 'form-check-label'
    
    = link_to t('auth.forgot_password'), new_password_path(resource_name), class: 'auth-link'

  .form-actions
    = f.submit t('auth.sign_in'), class: 'btn btn-primary btn-lg btn-block'

  .auth-divider
    span= t('common.or')

  .auth-footer-text
    span.text-muted= t('auth.no_account')
    = link_to t('auth.sign_up'), new_registration_path(resource_name), class: 'auth-link auth-link-bold'

- if has_social_oauth
  .auth-divider
    span= t('auth.or_continue_with', default: 'or Continue with')

  .social-auth data-turbo="false"
    - if oauth_provider_keys.include?("apple")
      form.social-auth__provider-form action="/auth/apple" method="post" target="_top" data-turbo="false" data-turbo-frame="_top"
        input type="hidden" name="authenticity_token" value=form_authenticity_token
        button.social-auth__provider-btn type="submit" aria-label=t('auth.sign_in_with_apple', default: 'Continue with Apple')
          i.fa-brands.fa-apple
    - if oauth_provider_keys.include?("google_oauth2")
      form.social-auth__provider-form action="/auth/google_oauth2" method="post" target="_top" data-turbo="false" data-turbo-frame="_top"
        input type="hidden" name="authenticity_token" value=form_authenticity_token
        button.social-auth__provider-btn type="submit" aria-label=t('auth.sign_in_with_google', default: 'Continue with Google')
          i.fa-brands.fa-google
    - if oauth_provider_keys.include?("facebook")
      form.social-auth__provider-form action="/auth/facebook" method="post" target="_top" data-turbo="false" data-turbo-frame="_top"
        input type="hidden" name="authenticity_token" value=form_authenticity_token
        button.social-auth__provider-btn type="submit" aria-label=t('auth.sign_in_with_facebook', default: 'Continue with Facebook')
          i.fa-brands.fa-facebook
