- content_for :title, t('auth.sign_in')

h2.auth-title= t('auth.sign_in')

= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'auth-form' }) do |f|
  - if flash[:alert]
    .auth-alert.auth-alert-error
      i.fa-solid.fa-circle-exclamation
      span= flash[:alert]

  .form-group
    = f.label :email, t('auth.email')
    .input-wrapper
      i.fa-solid.fa-envelope.input-icon
      = f.email_field :email, class: 'form-input', autofocus: true, autocomplete: 'email', placeholder: 'email@example.com'

  .form-group
    = f.label :password, t('auth.password')
    .input-wrapper
      i.fa-solid.fa-lock.input-icon
      = f.password_field :password, class: 'form-input', autocomplete: 'current-password', placeholder: '••••••••'

  .form-row
    .form-check
      = f.check_box :remember_me, class: 'form-checkbox'
      = f.label :remember_me, t('auth.remember_me'), class: 'form-check-label'
    
    = link_to t('auth.forgot_password'), new_password_path(resource_name), class: 'auth-link'

  .form-actions
    = f.submit t('auth.sign_in'), class: 'btn btn-primary btn-lg btn-block'

  .auth-divider
    span= t('common.or')

  .auth-footer-text
    span.text-muted= t('auth.no_account')
    = link_to t('auth.sign_up'), new_registration_path(resource_name), class: 'auth-link auth-link-bold'

  .auth-divider
    span= t('auth.or_continue_with', default: 'or Continue with')

  .social-auth
    = button_to user_apple_omniauth_authorize_path, method: :post, class: 'social-auth__provider-btn', form: { class: 'social-auth__provider-form', data: { turbo: false } }, "aria-label": t('auth.sign_in_with_apple', default: 'Continue with Apple') do
      i.fa-brands.fa-apple
    = button_to user_google_oauth2_omniauth_authorize_path, method: :post, class: 'social-auth__provider-btn', form: { class: 'social-auth__provider-form', data: { turbo: false } }, "aria-label": t('auth.sign_in_with_google', default: 'Continue with Google') do
      i.fa-brands.fa-google
    = button_to user_facebook_omniauth_authorize_path, method: :post, class: 'social-auth__provider-btn', form: { class: 'social-auth__provider-form', data: { turbo: false } }, "aria-label": t('auth.sign_in_with_facebook', default: 'Continue with Facebook') do
      i.fa-brands.fa-facebook
