<mjml>
  <mj-head>
    <mj-title>Unlock your account - LibreMedia</mj-title>
    <mj-preview>Your account was locked after failed sign-in attempts.</mj-preview>
    <mj-attributes>
      <mj-all font-family="'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-text font-size="16px" line-height="1.6" color="#334155" />
      <mj-button background-color="#4A90E2" color="#ffffff" font-size="18px" font-weight="600" border-radius="12px" inner-padding="16px 32px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f1f5f9">
    <mj-section background-color="#F0F0F0" padding="24px 20px">
      <mj-column>
        <mj-text align="center" font-size="28px" font-weight="700" color="#0E2E54" letter-spacing="-0.5px">
          Libre<span style="color: #4A90E2;">Media</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="32px 24px" border-radius="0 0 16px 16px">
      <mj-column>
        <mj-text align="center" font-size="24px" font-weight="700" color="#1e293b" padding-bottom="8px">
          Account locked
        </mj-text>

        <mj-text align="center" padding-bottom="24px">
          Your account has been temporarily locked because of too many unsuccessful sign-in attempts.
        </mj-text>

        <mj-button href="<%= unlock_url(@resource, unlock_token: @token) %>">
          Unlock account
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 20px">
      <mj-column>
        <mj-text align="center" font-size="13px" color="#64748b">
          This message was sent automatically by LibreMedia.<br/>
          Need help? Contact us at
          <a href="mailto:<%= Settings.services.smtp.reply_to %>" style="color: #4A90E2; text-decoration: none;">
            <%= Settings.services.smtp.reply_to %>
          </a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
