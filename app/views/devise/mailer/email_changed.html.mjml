<mjml>
  <mj-head>
    <mj-title>Email changed - LibreMedia</mj-title>
    <mj-preview>Your account email address has been changed.</mj-preview>
    <mj-attributes>
      <mj-all font-family="'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-text font-size="16px" line-height="1.6" color="#334155" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f1f5f9">
    <mj-section background-color="#F0F0F0" padding="24px 20px">
      <mj-column>
        <mj-text align="center" font-size="28px" font-weight="700" color="#0E2E54" letter-spacing="-0.5px">
          Libre<span style="color: #4A90E2;">Media</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="32px 24px" border-radius="0 0 16px 16px">
      <mj-column>
        <mj-text align="center" font-size="24px" font-weight="700" color="#1e293b" padding-bottom="8px">
          Email address changed
        </mj-text>

        <mj-text align="center" padding-bottom="16px">
          We are notifying you that the email for your account has been changed.
        </mj-text>

        <mj-text align="center" font-size="14px" color="#334155" padding="16px" background-color="#F2F7FD" border-radius="8px">
          <strong><%= @resource.unconfirmed_email || @resource.email %></strong>
        </mj-text>

        <mj-text font-size="14px" color="#dc2626" background-color="#fef2f2" padding="16px" border-radius="8px" padding-top="16px">
          If this was not you, please reset your password immediately and contact support.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
