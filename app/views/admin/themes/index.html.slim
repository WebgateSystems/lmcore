- content_for :title, "Themes - Admin Panel"

ul.uk-breadcrumb.uk-margin-remove-bottom
  li
    span Themes

.uk-flex.uk-flex-middle.uk-margin-top
  .uk-flex-1
    h2.uk-heading-small.uk-margin-remove Themes
    p.uk-text-meta= "#{@pagy.count} themes total"
  = link_to new_admin_theme_path, class: "sc-button sc-button-primary"
    i.mdi.mdi-plus.uk-margin-small-right
    | New Theme

.uk-card.uk-margin-top
  .uk-card-body.uk-padding-small
    = form_tag admin_themes_path, method: :get, class: "uk-grid-small", "data-uk-grid": "" do
      div(class="uk-width-1-3@m")
        input.uk-input type="text" name="q" value=params[:q] placeholder="Search themes..."
      div(class="uk-width-1-4@m")
        select.uk-select name="status"
          option value="" All statuses
          - %w[default active inactive].each do |status|
            option value=status selected=(params[:status] == status)
              = status.humanize
      .uk-width-auto
        button.sc-button.sc-button-primary type="submit"
          i.mdi.mdi-magnify
        = link_to admin_themes_path, class: "sc-button sc-button-default uk-margin-small-left"
          i.mdi.mdi-refresh

.uk-card.uk-margin-top
  .uk-card-body.uk-padding-remove
    .uk-overflow-auto
      table.uk-table.uk-table-hover.uk-table-middle.uk-table-divider.uk-margin-remove
        thead
          tr
            th Name
            th Slug
            th Folder
            th Template folder
            th Status
            th Access
            th.uk-text-right Actions
        tbody
          - @themes.each do |theme|
            tr
              td= link_to theme.name, admin_theme_path(theme), class: "uk-link-reset"
              td
                code.uk-text-small= theme.slug
              td
                code.uk-text-small= theme.path.presence || theme.slug
              td
                - if theme.template_available?
                  span.uk-label.uk-label-success Available
                - else
                  span.uk-label.uk-label-danger Missing
              td
                span.uk-label class=(theme.default? ? "uk-label-success" : nil)
                  = theme.status
              td
                - if theme.exclusive_users.any?
                  = theme.exclusive_users.map { |user| user.username.presence || user.email }.join(", ")
                - else
                  span.uk-text-muted Public
              td.uk-text-right.uk-text-nowrap
                = link_to edit_admin_theme_path(theme), class: "uk-icon-link", title: "Edit"
                  i.mdi.mdi-pencil
                - unless theme.default?
                  = link_to admin_theme_path(theme), class: "uk-icon-link uk-margin-small-left md-color-red-500", title: "Delete", data: { turbo_method: :delete, turbo_confirm: "Delete theme record? Theme files will remain on disk." }
                    i.mdi.mdi-delete

- if @pagy.pages > 1
  .uk-flex.uk-flex-center.uk-margin-medium-top
    == pagy_nav(@pagy)
