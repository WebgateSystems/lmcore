= form_with model: [:admin, @theme], local: true, html: { multipart: true }, class: "uk-form-stacked" do |f|
  - if @theme.errors.any?
    .uk-alert.uk-alert-danger data-uk-alert=""
      a.uk-alert-close data-uk-close=""
      h4= "#{pluralize(@theme.errors.count, 'error')} prohibited this theme from being saved:"
      ul
        - @theme.errors.full_messages.each do |message|
          li= message

  .uk-margin-medium-top data-uk-grid=""
    div(class="uk-width-2-3@m")
      .uk-card
        .uk-card-header
          h3.uk-card-title Theme Details
        .uk-card-body
          .uk-margin
            = f.label :name, "Name", class: "uk-form-label"
            .uk-form-controls
              = f.text_field :name, class: "uk-input", required: true

          .uk-margin
            = f.label :slug, "Slug", class: "uk-form-label"
            .uk-form-controls
              = f.text_field :slug, class: "uk-input", required: true, placeholder: "default"
              p.uk-text-small.uk-text-muted Used in records and URLs. Keep it stable once users select the theme.

          .uk-margin
            = f.label :path, "Folder under themes/", class: "uk-form-label"
            .uk-form-controls
              = f.text_field :path, class: "uk-input", placeholder: "default"
              p.uk-text-small.uk-text-muted The folder must contain index.liquid and layouts/application.liquid.

          .uk-margin
            = f.label :description, "Description", class: "uk-form-label"
            .uk-form-controls
              = f.text_area :description, class: "uk-textarea", rows: 4

          .uk-margin
            = f.label :archive, "Upload theme ZIP", class: "uk-form-label"
            .uk-form-controls
              = file_field_tag "theme[archive]", class: "uk-input", accept: ".zip,application/zip"
              p.uk-text-small.uk-text-muted Upload a ZIP containing a theme folder or files directly. Existing files in the destination folder may be overwritten.

      .uk-card.uk-margin-top
        .uk-card-header
          h3.uk-card-title Exclusive Access
        .uk-card-body
          p.uk-text-small.uk-text-muted Leave empty to make this theme available to every blog. Select users to make it exclusive.
          .uk-grid-small data-uk-grid=""
            - selected_ids = @theme.exclusive_user_ids.map(&:to_s)
            - @users.each do |user|
              div(class="uk-width-1-2@m")
                label
                  = check_box_tag "theme[exclusive_user_ids][]", user.id, selected_ids.include?(user.id.to_s), class: "uk-checkbox"
                  span.uk-margin-small-left= "#{user.username.presence || user.email} (#{user.email})"
          = hidden_field_tag "theme[exclusive_user_ids][]", ""

    div(class="uk-width-1-3@m")
      .uk-card
        .uk-card-header
          h3.uk-card-title Settings
        .uk-card-body
          .uk-margin
            = f.label :status, "Status", class: "uk-form-label"
            .uk-form-controls
              = f.select :status, options_for_select(%w[default active inactive].map { |status| [status.humanize, status] }, @theme.status || "active"), {}, class: "uk-select"

          .uk-margin
            = f.label :version, "Version", class: "uk-form-label"
            .uk-form-controls
              = f.text_field :version, class: "uk-input", placeholder: "1.0.0"

          .uk-margin
            = f.label :author, "Author", class: "uk-form-label"
            .uk-form-controls
              = f.text_field :author, class: "uk-input"

          .uk-margin
            label
              = f.check_box :is_system, class: "uk-checkbox"
              span.uk-margin-small-left System theme

          .uk-margin
            label
              = f.check_box :is_premium, class: "uk-checkbox"
              span.uk-margin-small-left Premium theme

          .uk-margin
            = f.label :price_cents, "Price cents", class: "uk-form-label"
            .uk-form-controls
              = f.number_field :price_cents, class: "uk-input", min: 0

  .uk-margin-large-top.uk-flex.uk-flex-between
    div
      - if @theme.persisted? && !@theme.default?
        = link_to admin_theme_path(@theme), class: "sc-button sc-button-danger", data: { turbo_method: :delete, turbo_confirm: "Delete theme record? Theme files will remain on disk." }
          i.mdi.mdi-delete.uk-margin-small-right
          | Delete
    div
      = link_to "Cancel", (@theme.persisted? ? admin_theme_path(@theme) : admin_themes_path), class: "sc-button sc-button-default uk-margin-small-right"
      = f.submit (@theme.persisted? ? "Update Theme" : "Create Theme"), class: "sc-button sc-button-primary"
