doctype html
html lang=I18n.locale data-theme="light"
  head
    title= content_for(:title) || t('site.title')
    meta name="viewport" content="width=device-width, initial-scale=1"
    meta name="description" content=t('site.description')
    meta name="theme-color" content="#14B8A6"
    meta name="mobile-web-app-capable" content="yes"
    meta name="application-name" content="LibreMedia"
    = csrf_meta_tags
    = csp_meta_tag

    /! Favicon
    link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png"
    link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png"
    link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-icon-180x180.png"
    link rel="manifest" href="/favicon/manifest.json"

    /! Preconnect for fonts
    link rel="preconnect" href="https://fonts.googleapis.com"
    link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""

    /! Inter font
    link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"

    /! Main stylesheet (compiled from app/assets/stylesheets/application.sass.scss, includes Font Awesome)
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_include_tag "application", "data-turbo-track": "reload", type: "module"
    style
      |
        .landing-flash-stack {
          position: fixed;
          top: 14px;
          left: 50%;
          transform: translateX(-50%);
          z-index: 3000;
          width: min(92vw, 760px);
          display: flex;
          flex-direction: column;
          gap: 10px;
        }
        .landing-flash {
          border-radius: 10px;
          padding: 12px 14px;
          font-family: Inter, sans-serif;
          font-size: 14px;
          line-height: 1.35;
          box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
          border: 1px solid transparent;
        }
        .landing-flash--notice {
          background: #ecfdf3;
          border-color: #86efac;
          color: #14532d;
        }
        .landing-flash--alert {
          background: #fef2f2;
          border-color: #fca5a5;
          color: #991b1b;
        }
        .landing-flash--hidden {
          opacity: 0;
          transform: translateY(-6px);
          transition: opacity .25s ease, transform .25s ease;
        }

  body.landing-page
    - if notice || alert
      .landing-flash-stack
        - if notice
          .landing-flash.landing-flash--notice data-landing-flash=""
            = notice
        - if alert
          .landing-flash.landing-flash--alert data-landing-flash=""
            = alert
    = yield
    script
      |
        window.setTimeout(function () {
          document.querySelectorAll('[data-landing-flash]').forEach(function (el) {
            el.classList.add('landing-flash--hidden');
            window.setTimeout(function () { el.remove(); }, 300);
          });
        }, 2600);
