<article>
  <p class="meta">{{ video.published_at | date_format: "%d %b %Y" }}</p>
  <h1 class="section-title">{{ video.title }}</h1>
  {% if video.video_provider == "self_hosted" %}
    <video controls {% if video.thumbnail_url %}poster="{{ video.thumbnail_url }}"{% endif %}>
      <source src="{{ video.video_url }}" type="video/mp4">
    </video>
  {% elsif video.embed_url and video.embed_url != blank %}
    <iframe src="{{ video.embed_url }}" title="{{ video.title }}" width="900" height="506" allowfullscreen></iframe>
  {% endif %}
  {% if video.description and video.description != blank %}
    <div class="article-body">{{ video.description }}</div>
  {% endif %}
</article>

<section style="margin-top:36px">
  <h2>Comments</h2>
  {% if current_user and current_user_blog_banned != true %}
    <form class="comment-form" action="{{ base_path }}/videos/{{ video.slug }}/comments" method="post">
      <input type="hidden" name="authenticity_token" value="{{ csrf_token }}">
      <input type="hidden" name="return_to" value="{{ current_path_with_query }}">
      <textarea name="comment[content]" required placeholder="Write a comment"></textarea>
      <p><button class="button" type="submit">Publish comment</button></p>
    </form>
  {% else %}
    <p><a href="{{ login_return_url }}">Sign in to comment</a></p>
  {% endif %}
  {% for comment in comments %}
    <article class="comment">
      <strong>{{ comment.author_name }}</strong>
      <p>{{ comment.content }}</p>
    </article>
  {% endfor %}
</section>
