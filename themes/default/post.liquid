<article>
  <p class="meta">{{ post.published_at | date_format: "%d %b %Y" }}{% if post.category %} / {{ post.category.name }}{% endif %}</p>
  <h1 class="section-title">{{ post.title }}</h1>
  {% if post.subtitle and post.subtitle != blank %}
    <p class="meta">{{ post.subtitle }}</p>
  {% endif %}
  {% if post.featured_image and post.featured_image != blank %}
    <img src="{{ post.featured_image }}" alt="{{ post.title }}">
  {% endif %}
  <div class="article-body">
    {{ post.content }}
  </div>
  {% if post.tags and post.tags.size > 0 %}
    <div class="tag-list" style="margin-top:24px">
      {% for tag in post.tags %}
        <a href="{{ base_path }}/tags/{{ tag.slug }}">{{ tag.name }}</a>
      {% endfor %}
    </div>
  {% endif %}
</article>

{% if post.comments_enabled %}
  <section style="margin-top:36px">
    <h2>{{ post.comments_count | default: 0 }} comments</h2>
    {% if current_user and current_user_blog_banned != true %}
      <form class="comment-form" action="{{ base_path }}/posts/{{ post.slug }}/comments" method="post">
        <input type="hidden" name="authenticity_token" value="{{ csrf_token }}">
        <input type="hidden" name="return_to" value="{{ current_path_with_query }}">
        <textarea name="comment[content]" required placeholder="Write a comment"></textarea>
        <p><button class="button" type="submit">Publish comment</button></p>
      </form>
    {% elsif current_user_blog_banned %}
      <p>{{ current_user_blog_ban_reason | default: "You cannot comment on this blog." }}</p>
    {% else %}
      <p><a href="{{ login_return_url }}">Sign in to comment</a></p>
    {% endif %}
    {% for comment in comments %}
      <article class="comment">
        <strong>{{ comment.author_name }}</strong>
        <p>{{ comment.content }}</p>
        {% for reply in comment.replies %}
          <div class="comment" style="margin-left:24px">
            <strong>{{ reply.author_name }}</strong>
            <p>{{ reply.content }}</p>
          </div>
        {% endfor %}
      </article>
    {% endfor %}
  </section>
{% endif %}
