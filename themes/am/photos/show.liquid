<!-- Photo gallery page -->
<div class="current-page mobile-current-page"><a href="{{ base_path }}/photos">{{ 'navigation.photos' | t }}</a></div>
  <div class="section-article-item__btn-back section-article-item__btn-back-mobile">
    <a href="{{ base_path }}/photos">
      <span>
        <svg width="18" height="12" viewBox="0 0 18 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M4.41861 7.5L17.7197 7.5L17.7197 4.5L4.41861 4.5L4.41861 -1.16282e-06L-0.000327539 6L4.41861 12L4.41861 7.5Z" fill="black"/>
        </svg>
      </span>
      <span>BACK</span>
    </a>
  </div>
  <div class="section-article-item__container">
    <div class="container-fluid container">
      <div class="section-article-item__body-container row">
        <!-- Mobile reviews -->
        <div class="section-article-item__reviews--mobile">
          <div class="section-dashboard__item-date-rewiews">
            <p class="article-date">{{ photo.published_at | date_format }}</p>
            <div class="section-dashboard__item-date-rewiews-counter">
              <div class="section-dashboard__item-rewiews">
                <svg width="26" height="22" viewBox="0 0 26 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2.16667 4.4H0V9.9H0.0108333L0 19.8C0 21.01 0.975 22 2.16667 22H21.6667V19.8H2.16667V4.4ZM23.8333 2.2H15.1667L13 0H6.5C5.30833 0 4.34417 0.99 4.34417 2.2L4.33333 15.4C4.33333 16.61 5.30833 17.6 6.5 17.6H23.8333C25.025 17.6 26 16.61 26 15.4V4.4C26 3.19 25.025 2.2 23.8333 2.2ZM7.58333 14.3L12.4583 7.7L16.25 12.661L18.9583 9.35L22.75 14.3H7.58333Z" fill="black"/>
                </svg>
                <span>{{ photo.photos_count | default: photo.images.size | default: 1 }}</span>
              </div>
            </div>
          </div>
        </div>
        <!-- Title -->
        <div class="section-article-item__title">
          {% assign title_parts = photo.title | split: '|' %}
          {% for part in title_parts %}
          <h2>{{ part }}</h2>
          {% endfor %}
        </div>
        <!-- Body -->
        <div class="section-article-item__body">
          <div class="section-article-item__description">
            <div class="section-article-item__description-inner">
              {% if photo.subtitle %}
              <div class="section-article-item__subtitle">
                <h2>{{ photo.subtitle }}</h2>
              </div>
              {% endif %}
              <div class="section-article-item__date">
                <div class="section-dashboard__item-date-rewiews">
                  <p class="article-date">{{ photo.published_at | date_format }}</p>
                </div>
              </div>
              <div class="section-article-item__text">
                {% if photo.description %}
                <div class="section-article-item__paragraph">{{ photo.description }}</div>
                {% endif %}
                <!-- Gallery -->
                <div class="section-article-item__img-container row" id="lightgallery">
                  {% if photo.images.size > 0 %}
                    {% for image in photo.images %}
                    <a href="{{ image.url }}"><img class="lazyload" src="{{ image.url }}" alt="{{ image.alt | default: photo.title }}" width="380" height="230"></a>
                    {% endfor %}
                  {% else %}
                    {% for i in (1..7) %}
                    <a href="/themes/am/img/image/photo/photo-{{ i }}.png"><img class="lazyload" src="/themes/am/img/image/photo/photo-{{ i }}.png" alt="{{ photo.title }}" width="380" height="230"></a>
                    {% endfor %}
                  {% endif %}
                </div>
                <!-- Tags -->
                {% if photo.tags.size > 0 %}
                <div class="section-article-item__tags">
                  {% for tag in photo.tags %}
                  <span><a href="{{ base_path }}/tags/{{ tag.slug }}">#{{ tag.name }}</a></span>
                  {% endfor %}
                </div>
                {% endif %}
                <!-- Social -->
                <div class="section-article-item__social" style="margin-top: 40px;">
                  <div class="footer__social-icon"><a href="{{ site.facebook_url | default: '#' }}" target="_blank" rel="noopener" title="Facebook"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M24 12C24 5.37258 18.6274 0 12 0C5.37258 0 0 5.37258 0 12C0 17.9895 4.3882 22.954 10.125 23.8542V15.4688H7.07812V12H10.125V9.35625C10.125 6.34875 11.9166 4.6875 14.6576 4.6875C15.9701 4.6875 17.3438 4.92188 17.3438 4.92188V7.875H15.8306C14.34 7.875 13.875 8.80008 13.875 9.75V12H17.2031L16.6711 15.4688H13.875V23.8542C19.6118 22.954 24 17.9895 24 12Z" fill="#959595"/></svg></a></div>
                  <div class="footer__social-icon"><a href="{{ site.youtube_url | default: '#' }}" target="_blank" rel="noopener" title="YouTube"><svg width="28" height="20" viewBox="0 0 28 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M27.4169 3.13049C27.1063 1.95366 26.1831 1.02299 25.0168 0.710027C22.8915 0.142578 14.0715 0.142578 14.0715 0.142578C14.0715 0.142578 5.25148 0.142578 3.12613 0.710027C1.95987 1.02303 1.03668 1.95366 0.726055 3.13049C0.164062 5.27281 0.164062 9.74311 0.164062 9.74311C0.164062 9.74311 0.164062 14.2134 0.726055 16.3557C1.03668 17.5326 1.95987 18.4632 3.12613 18.7762C5.25148 19.3436 14.0715 19.3436 14.0715 19.3436C14.0715 19.3436 22.8915 19.3436 25.0168 18.7762C26.1831 18.4632 27.1063 17.5326 27.4169 16.3557C27.9789 14.2134 27.9789 9.74311 27.9789 9.74311C27.9789 5.27281 27.9789 3.13049 27.4169 3.13049ZM11.2483 13.857V5.62922L18.4397 9.74319L11.2483 13.857Z" fill="#959595"/></svg></a></div>
                  <div class="footer__social-icon"><a href="{{ site.instagram_url | default: '#' }}" target="_blank" rel="noopener" title="Instagram"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2.163C15.204 2.163 15.584 2.175 16.85 2.233C20.102 2.381 21.621 3.924 21.769 7.152C21.827 8.417 21.838 8.797 21.838 12.001C21.838 15.206 21.826 15.585 21.769 16.85C21.62 20.075 20.105 21.621 16.85 21.769C15.584 21.827 15.206 21.839 12 21.839C8.796 21.839 8.416 21.827 7.151 21.769C3.891 21.62 2.38 20.07 2.232 16.849C2.174 15.584 2.162 15.205 2.162 12C2.162 8.796 2.175 8.417 2.232 7.151C2.381 3.924 3.896 2.38 7.151 2.232C8.417 2.175 8.796 2.163 12 2.163ZM12 0C8.741 0 8.333 0.014 7.053 0.072C2.695 0.272 0.273 2.69 0.073 7.052C0.014 8.333 0 8.741 0 12C0 15.259 0.014 15.668 0.072 16.948C0.272 21.306 2.69 23.728 7.052 23.928C8.333 23.986 8.741 24 12 24C15.259 24 15.668 23.986 16.948 23.928C21.302 23.728 23.73 21.31 23.927 16.948C23.986 15.668 24 15.259 24 12C24 8.741 23.986 8.333 23.928 7.053C23.728 2.695 21.31 0.273 16.948 0.073C15.668 0.014 15.259 0 12 0ZM12 5.838C8.597 5.838 5.838 8.597 5.838 12C5.838 15.403 8.597 18.162 12 18.162C15.403 18.162 18.162 15.403 18.162 12C18.162 8.597 15.403 5.838 12 5.838ZM12 16C9.791 16 8 14.209 8 12C8 9.791 9.791 8 12 8C14.209 8 16 9.791 16 12C16 14.209 14.209 16 12 16ZM18.406 4.155C17.61 4.155 16.965 4.8 16.965 5.595C16.965 6.39 17.61 7.035 18.406 7.035C19.201 7.035 19.845 6.39 19.845 5.595C19.845 4.8 19.201 4.155 18.406 4.155Z" fill="#959595"/></svg></a></div>
                  <div class="footer__social-icon"><a href="{{ site.threads_url | default: '#' }}" target="_blank" rel="noopener" title="Threads"><svg width="24" height="24" viewBox="0 0 192 192" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M141.537 88.9883C140.71 88.5919 139.87 88.2104 139.019 87.8451C137.537 60.5382 122.616 44.905 97.5619 44.745C97.4484 44.7443 97.3355 44.7443 97.2227 44.7443C82.2177 44.7443 70.0046 51.1409 62.5334 62.5238L75.9043 71.2694C81.4831 63.0044 90.2816 60.3182 97.2326 60.3182C97.2999 60.3182 97.3679 60.3182 97.4352 60.3189C106.009 60.3696 112.515 62.7754 116.688 67.598C119.754 71.1547 121.852 76.0053 122.956 82.0951C115.705 80.8408 107.771 80.3893 99.2119 80.7422C74.9601 81.8199 59.1916 94.8491 60.3068 113.114C60.8766 122.189 65.5889 130.054 73.5532 135.155C80.2892 139.457 88.9661 141.472 97.9402 141.042C110.197 140.443 119.846 136.139 126.608 128.206C131.771 122.148 135.234 114.369 137.055 104.621C143.455 108.311 148.193 113.197 150.691 119.204C154.874 129.124 155.126 145.675 140.674 160.097C128.064 172.686 112.943 178.449 92.42 178.617C69.5461 178.433 51.9584 171.158 40.135 157.021C29.0422 143.729 23.2898 124.925 23.0737 101.443C23.2898 77.9613 29.0422 59.1576 40.135 45.8655C51.9584 31.7286 69.5461 24.4536 92.42 24.2699C115.46 24.4543 133.36 31.7927 145.418 46.0698C151.323 53.0618 155.775 61.6371 158.709 71.582L173.605 67.4633C170.024 55.1751 164.407 44.6164 156.728 35.8855C141.695 18.5493 120.455 9.66516 93.1417 9.49982L92.42 9.49536L91.6984 9.49982C64.3848 9.66516 43.1447 18.5493 28.1119 35.8855C15.5006 50.4624 8.4949 70.8538 8.22646 96.8074L8.22437 101.438L8.22646 106.069C8.4949 132.023 15.5006 152.418 28.1119 166.995C43.1447 184.332 64.3848 193.22 91.6984 193.385L92.42 193.39L93.1417 193.385C117.507 193.189 136.07 185.874 151.326 170.635C171.899 150.087 170.871 124.282 164.632 109.728C159.892 98.6645 151.489 90.057 141.537 88.9883ZM98.7187 125.507C88.6717 126.022 75.4195 122.163 74.7109 112.231C74.178 105.009 80.4866 96.7836 99.6544 95.9217C102.29 95.8015 104.874 95.7431 107.406 95.7431C113.605 95.7431 119.465 96.2657 124.898 97.2627C122.842 121.408 111.401 124.869 98.7187 125.507Z" fill="#959595"/></svg></a></div>
                  <div class="footer__social-icon"><a href="{{ site.bluesky_url | default: '#' }}" target="_blank" rel="noopener" title="Bluesky"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.3 4.2C8.5 6.1 10.9 10 12 12C13.1 10 15.5 6.1 17.7 4.2C19.2 2.9 21.7 2 21.7 4.8C21.7 5.4 21.4 10.2 21.2 10.9C20.5 13.5 17.8 14.2 15.4 13.8C19.5 14.5 20.6 16.8 18.4 19.1C14.2 23.4 12.5 18 12 16.5C11.5 18 9.8 23.4 5.6 19.1C3.4 16.8 4.5 14.5 8.6 13.8C6.2 14.2 3.5 13.5 2.8 10.9C2.6 10.2 2.3 5.4 2.3 4.8C2.3 2 4.8 2.9 6.3 4.2Z" fill="#959595"/></svg></a></div>
                </div>
                <!-- Back button -->
                <div class="section-article-item__btn-back">
                  <a href="{{ base_path }}/photos">
                    <span>
                      <svg width="18" height="12" viewBox="0 0 18 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M4.41861 7.5L17.7197 7.5L17.7197 4.5L4.41861 4.5L4.41861 -1.16282e-06L-0.000327539 6L4.41861 12L4.41861 7.5Z" fill="black"/>
                      </svg>
                    </span>
                    <span>{{ 'content.back_to_photos' | t }}</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- Comments section -->
      <div class="section-article-item__comments row">
        <div class="section-article-item__comments-top">
          <div class="section-article-item__comments-title">
            <div class="section-article-item__comments-title-ico">
              <a href="">
                <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M27.986 2.8C27.986 1.26 26.74 0 25.2 0H2.8C1.26 0 0 1.26 0 2.8V19.6C0 21.14 1.26 22.4 2.8 22.4H22.4L28 28L27.986 2.8ZM22.4 16.8H5.6V14H22.4V16.8ZM22.4 12.6H5.6V9.8H22.4V12.6ZM22.4 8.4H5.6V5.6H22.4V8.4Z" fill="black"/>
                </svg>
              </a>
            </div>
            <div class="section-article-item__comments-title-text">{{ photo.comments_count | default: 0 }} {{ 'comments.title' | t }}</div>
          </div>
          <div class="section-article-item__btn-login--mobile">
            <div class="section-article-item__btn-login--mobile-text js_authorization_open">{{ 'comments.login_to_comment' | t }}</div>
            <div class="section-article-item__btn-login--mobile-ico">
              <svg width="19" height="12" viewBox="0 0 19 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M13.7579 4.5H0.287109V7.5H13.7579V12L18.2332 6L13.7579 0V4.5Z" fill="white"/>
              </svg>
            </div>
          </div>
        </div>
        <div class="section-article-item__comments-body-container">
          <div class="section-article-item__comments-body">
            <ul class="section-article-item__comments-body-list">
              {% for comment in comments %}
              <li class="section-article-item__comments-item-container">
                <div class="section-article-item__comments-item">
                  <div class="section-article-item__comments-item-user-ico">
                    <a href="">
                      <svg width="96" height="96" viewBox="0 0 96 96" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M48 0C21.504 0 0 21.504 0 48C0 74.496 21.504 96 48 96C74.496 96 96 74.496 96 48C96 21.504 74.496 0 48 0ZM48 14.4C55.968 14.4 62.4 20.832 62.4 28.8C62.4 36.768 55.968 43.2 48 43.2C40.032 43.2 33.6 36.768 33.6 28.8C33.6 20.832 40.032 14.4 48 14.4ZM48 82.56C36 82.56 25.392 76.416 19.2 67.104C19.344 57.552 38.4 52.32 48 52.32C57.552 52.32 76.656 57.552 76.8 67.104C70.608 76.416 60 82.56 48 82.56Z" fill="#959595"/>
                      </svg>
                    </a>
                  </div>
                  <div class="section-article-item__comments-item-wrapper">
                    <div class="section-article-item__comments-item-info">
                      <div class="section-article-item__comments-item-user-name">
                        <span>{{ 'comments.added_by' | t }}</span>
                        <span class="user-name"><a href="#">{{ comment.author_name }}</a></span>
                        <span>,</span>
                      </div>
                      <div class="section-article-item__comments-item-date">{{ comment.created_at | date: '%d %B %Y o %H:%M' }}</div>
                    </div>
                    <div class="section-article-item__comments-item-text">{{ comment.content }}</div>
                    <div class="section-article-item__comments-item-answer-btn js_add_comment"><a href="#">{{ 'comments.reply' | t }}</a></div>
                    <div class="section-article-item__comment-answer-form">
                      <div class="section-article-item__comment-answer-textarea">
                        <textarea class="comment_area" placeholder="{{ 'comments.write_here' | t }}"></textarea>
                      </div>
                      <div class="section-article-item__comment-answer-btn js_comment_submit js_submit">
                        <button {% unless current_user %}disabled{% endunless %}>{{ 'comments.post_reply' | t }}</button>
                      </div>
                    </div>
                  </div>
                </div>
                {% if comment.replies.size > 0 %}
                <ul class="section-article-item__comments-body-list">
                  {% for reply in comment.replies %}
                  <li class="section-article-item__comments-item-container">
                    <div class="section-article-item__comments-item">
                      <div class="section-article-item__comments-item-user-ico">
                        <a href="">
                          <svg width="96" height="96" viewBox="0 0 96 96" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M48 0C21.504 0 0 21.504 0 48C0 74.496 21.504 96 48 96C74.496 96 96 74.496 96 48C96 21.504 74.496 0 48 0ZM48 14.4C55.968 14.4 62.4 20.832 62.4 28.8C62.4 36.768 55.968 43.2 48 43.2C40.032 43.2 33.6 36.768 33.6 28.8C33.6 20.832 40.032 14.4 48 14.4ZM48 82.56C36 82.56 25.392 76.416 19.2 67.104C19.344 57.552 38.4 52.32 48 52.32C57.552 52.32 76.656 57.552 76.8 67.104C70.608 76.416 60 82.56 48 82.56Z" fill="#959595"/>
                          </svg>
                        </a>
                      </div>
                      <div class="section-article-item__comments-item-wrapper">
                        <div class="section-article-item__comments-item-info">
                          <div class="section-article-item__comments-item-user-name">
                            <span>{{ 'comments.added_by' | t }}</span>
                            <span class="user-name"><a href="#">{{ reply.author_name }}</a></span>
                            <span>,</span>
                          </div>
                          <div class="section-article-item__comments-item-date">{{ reply.created_at | date: '%d %B %Y o %H:%M' }}</div>
                        </div>
                        <div class="section-article-item__comments-item-text">{{ reply.content }}</div>
                        <div class="section-article-item__comments-item-answer-btn js_add_comment"><a href="#">{{ 'comments.reply' | t }}</a></div>
                        <div class="section-article-item__comment-answer-form">
                          <div class="section-article-item__comment-answer-textarea">
                            <textarea class="comment_area" placeholder="{{ 'comments.write_here' | t }}"></textarea>
                          </div>
                          <div class="section-article-item__comment-answer-btn js_comment_submit js_submit">
                            <button {% unless current_user %}disabled{% endunless %}>{{ 'comments.post_reply' | t }}</button>
                          </div>
                        </div>
                      </div>
                    </div>
                  </li>
                  {% endfor %}
                </ul>
                {% endif %}
              </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
