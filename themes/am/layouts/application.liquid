<!DOCTYPE html>
<html lang="{{ locale | default: 'uk' }}">

<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="initial-scale=1.0, width=device-width">
  <title>{% if page_title %}{{ page_title }} – {% endif %}{{ site.site_name | default: 'Айдер Муждабаєв' }}</title>
  <meta name="description" content="{{ page_description | default: site.site_description }}">
  
  <!-- Font preload -->
  <link rel="preload" href="/themes/am/fonts/FiraSansExtraCondensed-ExtraBold.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/themes/am/fonts/FiraSansExtraCondensed-Bold.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/themes/am/fonts/FiraSansExtraCondensed-SemiBold.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/themes/am/fonts/FiraSansExtraCondensed-Medium.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/themes/am/fonts/FiraSansExtraCondensed-Regular.woff2" as="font" type="font/woff2" crossorigin>
  
  <!-- Favicon -->
  <link rel="icon" href="/themes/am/img/favicon/favicon.ico" type="image/x-icon">
  <link rel="apple-touch-icon" sizes="180x180" href="/themes/am/img/favicon/apple-icon-180x180.png">
  
  <!-- Stylesheets -->
  <link rel="stylesheet" href="/themes/am/css/libs/swiper-bundle.min.css">
  <link rel="stylesheet" href="/themes/am/css/libs/lightgallery-bundle.min.css">
  <link rel="stylesheet" href="/themes/am/css/main.min.css">
  
  <!-- Custom overrides -->
  <style>
    /* Hero image: preserve aspect ratio on wide viewports where max-height caps height
       while width: 35vw keeps growing */
    .section-name__content-image img {
      object-fit: contain;
      object-position: bottom right;
    }

    /* Hero layout: text first, image below on mobile (original uses column-reverse) */
    @media (max-width: 680px) {
      .section-name__content {
        -webkit-box-orient: vertical !important;
        -webkit-box-direction: normal !important;
        -ms-flex-direction: column !important;
        flex-direction: column !important;
      }
      .section-name__text--white {
        position: relative !important;
        top: 0 !important;
      }
    }

    /* Problem 3: Make article title links inherit color and hover red */
    .section-main-articles__article-description h2 a {
      color: inherit;
      text-decoration: none;
    }
    .section-main-articles__article-description h2 a:hover {
      color: #c52a2a;
    }
    
    /* Problem 4: Ensure minimum height for article content to prevent overlap */
    .section-article-item__description-inner {
      min-height: 500px;
    }
    .section-article-item__text {
      padding-bottom: 100px;
    }
    
    /* Problem 2: Default font styling for article content paragraphs */
    .section-article__content-text {
      font-family: 'Fira Sans Extra Condensed', sans-serif;
      font-size: 24px;
      line-height: 1.4;
    }
    .section-article__content-text p,
    .section-article__content-text div:not([class]) {
      margin-bottom: 20px;
      font-size: 24px;
      line-height: 1.4;
    }
    .section-article-item__paragraph {
      margin-bottom: 20px;
    }
    
    /* Stats counters - icon + number only, fixed spacing, desktop only */
    .section-article-item__stats-counters {
      display: flex;
      align-items: center;
      gap: 20px;
    }
    .section-article-item__stat-item {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .section-article-item__stat-item svg {
      flex-shrink: 0;
    }
    .section-article-item__stat-item span {
      font-family: 'Fira Sans Extra Condensed', sans-serif;
      font-weight: 600;
      font-size: 18px;
    }
    /* Hide on mobile - already shown at top */
    @media (max-width: 768px) {
      .section-article-item__stats-counters {
        display: none;
      }
    }
    /* Login button full width on mobile (680px and below) */
    @media (max-width: 680px) {
      .section-article-item__btn-login--mobile {
        width: calc(100% - 40px) !important;
        max-width: none !important;
        margin: 0 20px !important;
      }
    }
    
    /* Fixed spacing between social icons, back button and comments section */
    .section-article-item__tags {
      margin-bottom: 40px !important;
    }
    .section-article-item__social {
      margin-bottom: 15px !important;
      margin-top: 0 !important;
    }
    .section-article-item__btn-back {
      margin-bottom: 20px !important;
      margin-top: 15px !important;
    }
    .section-article-item__comments {
      margin-top: 20px !important;
      padding-top: 20px !important;
    }
    
    /* Mobile: equal spacing between tags -> social -> login button */
    @media (max-width: 680px) {
      .section-article-item__tags {
        margin-bottom: 40px !important;
      }
      /* Comment separators - black line between comments */
      .section-article-item__comments-item-container {
        border-bottom: 1px solid #000 !important;
        padding-bottom: 25px !important;
        margin-bottom: 25px !important;
      }
      .section-article-item__comments-item-container:last-child {
        border-bottom: none !important;
      }
      /* Make comment item full width */
      .section-article-item__comments-item {
        width: 100% !important;
      }
      .section-article-item__comments-item-wrapper {
        width: 100% !important;
        flex: 1 !important;
      }
      /* Reply form - hidden by default, full width when visible */
      .section-article-item__comment-answer-form {
        display: none;
        margin-top: 15px;
        width: 100% !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
      }
      .section-article-item__comment-answer-form._active {
        display: block !important;
      }
      .section-article-item__comment-answer-textarea {
        margin-bottom: 10px;
        width: 100% !important;
        max-width: 100% !important;
      }
      .section-article-item__comment-answer-textarea textarea {
        width: 100% !important;
        max-width: 100% !important;
        min-height: 100px;
        padding: 15px;
        border: 1px solid #000;
        font-family: 'Fira Sans Extra Condensed', sans-serif;
        font-size: 16px;
        resize: vertical;
        box-sizing: border-box !important;
      }
      /* Ensure comments body takes full width */
      .section-article-item__comments-body-container,
      .section-article-item__comments-body,
      .section-article-item__comments-body-list {
        width: 100% !important;
      }
      .section-article-item__comment-answer-textarea textarea::placeholder {
        color: #999;
      }
      .section-article-item__comment-answer-btn {
        text-align: right;
      }
      .section-article-item__comment-answer-btn button {
        background: #000;
        color: #fff;
        border: none;
        padding: 10px 25px;
        font-family: 'Fira Sans Extra Condensed', sans-serif;
        font-size: 14px;
        text-transform: uppercase;
        cursor: pointer;
      }
      /* Reply link styling */
      .section-article-item__comments-item-answer-btn {
        cursor: pointer;
      }
      .section-article-item__comments-item-answer-btn a {
        color: inherit;
        text-decoration: none;
        cursor: pointer;
      }
      .section-article-item__comments-item-answer-btn:hover,
      .section-article-item__comments-item-answer-btn a:hover {
        text-decoration: underline;
      }
      /* Disabled button */
      .section-article-item__comment-answer-btn button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }
      .section-article-item__social {
        margin-top: 0 !important;
        margin-bottom: 0 !important;
      }
      .section-article-item__btn-back {
        margin-top: 15px !important;
        margin-bottom: 0 !important;
      }
      .section-article-item__text {
        padding-bottom: 0 !important;
        margin-bottom: 0 !important;
      }
      .section-article-item__comments {
        margin-top: 25px !important;
        padding-top: 0 !important;
      }
      .section-article-item__comments-top {
        margin-top: 0 !important;
        padding-top: 0 !important;
      }
      .section-article-item__btn-login--mobile {
        margin-top: 0 !important;
      }
    }
  </style>
</head>

<body class="page {{ body_class | default: 'homepage' }}">
  <div class="page__wrapper">
    
    <!-- Header -->
    <header class="header">
      <div class="container-fluid container">
        <div class="header__inner">
          <div class="header__logo-wrapper">
            <div class="header__logo">
              <a href="{{ base_path }}">
                <picture>
                  <source class="lazyload" srcset="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-srcset="/themes/am/img/image/logo-header.webp" type="image/webp">
                  <img class="lazyload" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="/themes/am/img/image/logo-header.png" alt="{{ site.site_name }}" width="530" height="513">
                </picture>
              </a>
            </div>
          </div>
          <div class="header__nav-wrapper">
            <div class="header__nav">
              <div class="header__nav-item site-title__small js_nav-item"><a href="{{ base_path }}">{{ 'navigation.home' | t }}</a></div>
              <div class="header__nav-item site-title__small js_nav-item"><a href="{{ base_path }}/pages/about">{{ 'navigation.about' | t }}</a></div>
              <div class="header__nav-item site-title__small js_nav-item"><a href="{{ base_path }}/videos">{{ 'navigation.videos' | t }}</a></div>
              <div class="header__nav-item site-title__small js_nav-item"><a href="{{ base_path }}/posts">{{ 'navigation.articles' | t }}</a></div>
              <div class="header__nav-item site-title__small js_nav-item"><a href="{{ base_path }}/photos">{{ 'navigation.photos' | t }}</a></div>
              
              <!-- Language switcher -->
              <div class="header__nav-item lang-list-wrapper">
                <div class="header__lang-item _active site-title__small"><a href="#">{{ locale_display | default: locale | upcase }}</a></div>
                <div class="header__lang-list">
                  {% for item in blog_locale_switcher_items %}
                    {% unless item.canonical == locale %}
                    <div class="header__lang-item site-title__small"><a href="{{ base_path }}/locale/{{ item.path_segment }}">{{ item.ui_tag }}</a></div>
                    {% endunless %}
                  {% endfor %}
                </div>
                <div class="header__lang-ico">
                  <svg width="14" height="11" viewBox="0 0 14 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M13.022 1.53688C13.4456 0.871152 12.9674 -4.51356e-08 12.1783 -7.96279e-08L1.82167 -5.32332e-07C1.03258 -5.66824e-07 0.554368 0.87115 0.978012 1.53687L6.15634 9.67424C6.54929 10.2917 7.45071 10.2917 7.84366 9.67425L13.022 1.53688Z" fill="black"/>
                  </svg>
                </div>
              </div>
              
              <!-- Search button -->
              <div class="header__nav-item">
                <div class="header__search">
                  <svg width="19" height="19" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M15.2939 13.5786H14.3905L14.0703 13.2699C15.191 11.9663 15.8656 10.2739 15.8656 8.43282C15.8656 4.32762 12.538 1 8.43282 1C4.32762 1 1 4.32762 1 8.43282C1 12.538 4.32762 15.8656 8.43282 15.8656C10.2739 15.8656 11.9663 15.191 13.2699 14.0703L13.5786 14.3905V15.2939L19.2962 21L21 19.2962L15.2939 13.5786ZM8.43282 13.5786C5.58548 13.5786 3.28702 11.2802 3.28702 8.43282C3.28702 5.58548 5.58548 3.28702 8.43282 3.28702C11.2802 3.28702 13.5786 5.58548 13.5786 8.43282C13.5786 11.2802 11.2802 13.5786 8.43282 13.5786Z" fill="black" stroke="black" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              </div>
            </div>
            
            <!-- Mobile language button -->
            <div class="header__menu-lang--mobile">
              <div class="header__menu-lang--mobile-item js_lang_mobile_btn">{{ locale_display | default: locale | upcase }}</div>
            </div>
            
            <!-- Mobile menu button -->
            <div class="header__menu-mobile-btn">
              <div class="header__btn-menu menu-open _active">
                <svg width="34" height="32" viewBox="0 0 34 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M0 26.6667V32H34V26.6667H0ZM0 13.3333V18.6667H34V13.3333H0ZM0 0V5.33333H34V0H0Z" fill="black"/>
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>
    
    <!-- Main content -->
    <main class="page__content">
      <div class="main-wrap">
        {{ content }}
      </div>
    </main>
    
    <!-- Footer -->
    <footer class="footer">
      <div class="container-fluid container">
        <div class="footer__inner">
          <div class="footer__content row">
            <!-- Social -->
            <div class="footer__social col">
              <div class="footer__social-title">
                <h2 class="site-title__small-18">{{ 'footer.follow_me' | t }}</h2>
              </div>
              <div class="footer__social-icons">
                <!-- Facebook -->
                <div class="footer__social-icon"><a href="{{ site.facebook_url | default: '#' }}" target="_blank" rel="noopener" title="Facebook"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M24 12C24 5.37258 18.6274 0 12 0C5.37258 0 0 5.37258 0 12C0 17.9895 4.3882 22.954 10.125 23.8542V15.4688H7.07812V12H10.125V9.35625C10.125 6.34875 11.9166 4.6875 14.6576 4.6875C15.9701 4.6875 17.3438 4.92188 17.3438 4.92188V7.875H15.8306C14.34 7.875 13.875 8.80008 13.875 9.75V12H17.2031L16.6711 15.4688H13.875V23.8542C19.6118 22.954 24 17.9895 24 12Z" fill="#959595"/></svg></a></div>
                <!-- YouTube -->
                <div class="footer__social-icon"><a href="{{ site.youtube_url | default: '#' }}" target="_blank" rel="noopener" title="YouTube"><svg width="28" height="20" viewBox="0 0 28 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M27.4169 3.13049C27.1063 1.95366 26.1831 1.02299 25.0168 0.710027C22.8915 0.142578 14.0715 0.142578 14.0715 0.142578C14.0715 0.142578 5.25148 0.142578 3.12613 0.710027C1.95987 1.02303 1.03668 1.95366 0.726055 3.13049C0.164062 5.27281 0.164062 9.74311 0.164062 9.74311C0.164062 9.74311 0.164062 14.2134 0.726055 16.3557C1.03668 17.5326 1.95987 18.4632 3.12613 18.7762C5.25148 19.3436 14.0715 19.3436 14.0715 19.3436C14.0715 19.3436 22.8915 19.3436 25.0168 18.7762C26.1831 18.4632 27.1063 17.5326 27.4169 16.3557C27.9789 14.2134 27.9789 9.74311 27.9789 9.74311C27.9789 9.74311 27.9789 5.27281 27.4169 3.13049ZM11.2483 13.857V5.62922L18.4397 9.74319L11.2483 13.857Z" fill="#959595"/></svg></a></div>
                <!-- Instagram -->
                <div class="footer__social-icon"><a href="{{ site.instagram_url | default: '#' }}" target="_blank" rel="noopener" title="Instagram"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2.163C15.204 2.163 15.584 2.175 16.85 2.233C20.102 2.381 21.621 3.924 21.769 7.152C21.827 8.417 21.838 8.797 21.838 12.001C21.838 15.206 21.826 15.585 21.769 16.85C21.62 20.075 20.105 21.621 16.85 21.769C15.584 21.827 15.206 21.839 12 21.839C8.796 21.839 8.416 21.827 7.151 21.769C3.891 21.62 2.38 20.07 2.232 16.849C2.174 15.584 2.162 15.205 2.162 12C2.162 8.796 2.175 8.417 2.232 7.151C2.381 3.924 3.896 2.38 7.151 2.232C8.417 2.175 8.796 2.163 12 2.163ZM12 0C8.741 0 8.333 0.014 7.053 0.072C2.695 0.272 0.273 2.69 0.073 7.052C0.014 8.333 0 8.741 0 12C0 15.259 0.014 15.668 0.072 16.948C0.272 21.306 2.69 23.728 7.052 23.928C8.333 23.986 8.741 24 12 24C15.259 24 15.668 23.986 16.948 23.928C21.302 23.728 23.73 21.31 23.927 16.948C23.986 15.668 24 15.259 24 12C24 8.741 23.986 8.333 23.928 7.053C23.732 2.699 21.311 0.273 16.949 0.073C15.668 0.014 15.259 0 12 0ZM12 5.838C8.597 5.838 5.838 8.597 5.838 12C5.838 15.403 8.597 18.163 12 18.163C15.403 18.163 18.162 15.404 18.162 12C18.162 8.597 15.403 5.838 12 5.838ZM12 16C9.791 16 8 14.21 8 12C8 9.791 9.791 8 12 8C14.209 8 16 9.791 16 12C16 14.21 14.209 16 12 16ZM18.406 4.155C17.61 4.155 16.965 4.8 16.965 5.595C16.965 6.39 17.61 7.035 18.406 7.035C19.201 7.035 19.845 6.39 19.845 5.595C19.845 4.8 19.201 4.155 18.406 4.155Z" fill="#959595"/></svg></a></div>
                <!-- Threads -->
                <div class="footer__social-icon"><a href="{{ site.threads_url | default: '#' }}" target="_blank" rel="noopener" title="Threads"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M17.863 11.3419C17.7583 11.2949 17.6519 11.2503 17.5439 11.2083C17.3585 8.04055 15.4748 6.00291 12.3196 5.98338C12.3059 5.98332 12.2924 5.98332 12.2788 5.98332C10.4009 5.98332 8.84174 6.77746 7.86096 8.22842L9.63492 9.38912C10.3589 8.32094 11.4538 8.08238 12.2799 8.08238C12.2888 8.08238 12.2978 8.08238 12.3066 8.08244C13.3072 8.08889 14.0574 8.38141 14.5337 8.95369C14.8727 9.36 15.0959 9.91992 15.2017 10.6279C14.3379 10.4766 13.4033 10.4318 12.4063 10.4934C9.59174 10.6693 7.79664 12.2849 7.92182 14.5239C7.98578 15.6703 8.52594 16.6494 9.44342 17.2958C10.2222 17.8454 11.2196 18.1138 12.2611 18.0569C13.637 17.9812 14.7335 17.4688 15.5182 16.5364C16.1198 15.822 16.5018 14.9007 16.6699 13.7597C17.3021 14.1401 17.7787 14.6439 18.0654 15.2618C18.5542 16.3171 18.5838 18.0109 17.142 19.4534C15.8822 20.7137 14.3656 21.2655 12.2331 21.2814C9.84978 21.2635 8.02356 20.4926 6.81174 18.9929C5.67774 17.5899 5.09186 15.5946 5.06902 13.0427C5.09186 10.4907 5.67774 8.49555 6.81174 7.09244C8.02356 5.59281 9.84984 4.8218 12.2331 4.80402C14.6359 4.82193 16.492 5.59873 17.7417 7.10867C18.3541 7.84814 18.8185 8.76287 19.1276 9.82236L21.1301 9.2841C20.7436 7.93148 20.1406 6.76086 19.3243 5.77484C17.7152 3.83361 15.3695 2.82672 12.2395 2.80402L12.2267 2.80396C9.11592 2.82654 6.79566 3.83916 5.22354 5.78838C3.78726 7.56686 3.05628 10.0188 3.02832 13.0363L3.02826 13.0427L3.02832 13.049C3.05628 16.0665 3.78726 18.5185 5.22354 20.297C6.79572 22.2462 9.11598 23.2588 12.2268 23.2814L12.2395 23.2815C14.8574 23.2625 16.8183 22.5267 18.4541 20.8903C20.6108 18.7327 20.5449 15.9741 19.7878 14.3411C19.2283 13.1329 18.2033 12.1468 16.8032 11.5037C16.819 11.4836 17.863 11.3419 17.863 11.3419ZM12.1472 16.0604C11.0018 16.1243 9.96258 15.5772 9.90828 14.6093C9.86652 13.8634 10.4313 13.0189 12.2874 12.9027C12.4959 12.8896 12.7007 12.8833 12.9019 12.8833C13.6089 12.8833 14.2672 12.9565 14.8642 13.0982C14.6353 15.3954 13.5456 15.9816 12.1472 16.0604Z" fill="#959595"/></svg></a></div>
                <!-- Bluesky -->
                <div class="footer__social-icon"><a href="{{ site.bluesky_url | default: '#' }}" target="_blank" rel="noopener" title="Bluesky"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.3 4.2C8.5 6.1 10.9 10 12 12C13.1 10 15.5 6.1 17.7 4.2C19.2 2.9 21.7 2 21.7 4.8C21.7 5.4 21.4 10.2 21.2 10.9C20.5 13.5 17.8 14.2 15.4 13.8C19.5 14.5 20.6 16.8 18.4 19.1C14.2 23.4 12.5 18 12 16.5C11.5 18 9.8 23.4 5.6 19.1C3.4 16.8 4.5 14.5 8.6 13.8C6.2 14.2 3.5 13.5 2.8 10.9C2.6 10.2 2.3 5.4 2.3 4.8C2.3 2 4.8 2.9 6.3 4.2Z" fill="#959595"/></svg></a></div>
              </div>
              <div class="footer__social-contact desktop-contact js__popup_contact_open"><a href="javascript:void(0)">{{ 'footer.contact_me' | t }}</a></div>
              <div class="footer__social-contact mobile-contact js__popup_contact_open"><a href="javascript:void(0)">{{ 'footer.write_me' | t }}</a></div>
            </div>
            
            <!-- Links -->
            <div class="footer__links col">
              <div class="footer__links-menu">
                <div class="footer__links-title js_footer-menu-btn">
                  <h2 class="site-title__small-18">{{ 'footer.menu' | t }}</h2>
                  <div class="footer__links-title-ico mobile-content">
                    <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M14.9946 8.75H8.99463V14.75H6.99463V8.75H0.994629V6.75H6.99463V0.75H8.99463V6.75H14.9946V8.75Z" fill="white"/>
                    </svg>
                  </div>
                </div>
                <ul class="footer__links-list">
                  <li class="footer__links-item"><a href="{{ base_path }}/pages/about">{{ 'navigation.about' | t }}</a></li>
                  <li class="footer__links-item"><a href="{{ base_path }}/videos">{{ 'navigation.videos' | t }}</a></li>
                  <li class="footer__links-item"><a href="{{ base_path }}/posts">{{ 'navigation.articles' | t }}</a></li>
                  <li class="footer__links-item"><a href="{{ base_path }}/photos">{{ 'navigation.photos' | t }}</a></li>
                </ul>
              </div>
              <div class="footer__links-info">
                <div class="footer__links-title js_footer-info-btn">
                  <h2 class="site-title__small-18">{{ 'footer.information' | t }}</h2>
                  <div class="footer__links-title-ico mobile-content">
                    <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M14.9946 8.75H8.99463V14.75H6.99463V8.75H0.994629V6.75H6.99463V0.75H8.99463V6.75H14.9946V8.75Z" fill="white"/>
                    </svg>
                  </div>
                </div>
                <ul class="footer__links-list">
                  <li class="footer__links-item"><a href="#">{{ 'footer.privacy' | t }}</a></li>
                  <li class="footer__links-item"><a href="#">{{ 'footer.terms' | t }}</a></li>
                  <li class="footer__links-item"><a href="#">Cookies</a></li>
                </ul>
              </div>
            </div>
            
            <!-- Partners -->
            <div class="footer__partner col">
              <div class="footer__partner-title js_footer-partner-btn">
                <h2 class="site-title__small-18">{{ 'footer.friends' | t }}</h2>
                <div class="footer__links-title-ico mobile-content">
                  <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M14.9946 8.75H8.99463V14.75H6.99463V8.75H0.994629V6.75H6.99463V0.75H8.99463V6.75H14.9946V8.75Z" fill="white"/>
                  </svg>
                </div>
              </div>
              <div class="footer__partner-dashboard">
                <div class="footer__partner-row">
                  {% for partner in partners %}
                  <div class="footer__partner-item" id="partner-{{ partner.slug }}">
                    <a href="{{ partner.url | default: '#' }}" target="_blank" rel="noopener">
                      {{ partner.logo_svg }}
                    </a>
                    <div class="footer__partner-info">
                      <div class="footer__partner-info-text">
                        <h2>{{ partner.name }}</h2>
                        <p>{{ partner.description }}</p>
                      </div>
                      <div class="footer__partner-info-ico">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" fill="currentColor"/>
                        </svg>
                      </div>
                    </div>
                  </div>
                  {% endfor %}
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Footer rights -->
        <div class="footer__rights row">
          <div class="footer__rights-icon">
            <picture>
              <source srcset="/themes/am/img/image/logo-footer.webp" type="image/webp">
              <img class="lazyload" src="/themes/am/img/image/logo-footer.png" alt="{{ site.site_name }}">
            </picture>
          </div>
          <div class="footer__rights-text">{{ 'footer.copyright' | t }} {{ site.site_name | default: 'Айдер Муждабаєв' }}</div>
        </div>
      </div>
      
      <!-- Move up button -->
      <div class="move-up-btn-container">
        <div class="move-up-btn">
          <span>{{ 'footer.up' | t }}</span>
          <svg width="19" height="12" viewBox="0 0 19 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M13.7579 4.5H0.287109V7.5H13.7579V12L18.2332 6L13.7579 0V4.5Z" fill="white"/>
          </svg>
        </div>
      </div>
    </footer>
    
    <!-- Mobile menu -->
    <div class="mobile-menu mobile js__popup">
      <div class="mobile-menu__inner">
        <div class="mobile-menu__list">
          <div class="mobile-menu__item close-menu-btn">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M28 2.82L25.18 0L14 11.18L2.82 0L0 2.82L11.18 14L0 25.18L2.82 28L14 16.82L25.18 28L28 25.18L16.82 14L28 2.82Z" fill="white"/>
            </svg>
          </div>
          <div class="mobile-menu__item js_search_mobile_btn"><a class="mobile-menu__link" href="#">{{ 'navigation.search' | t }}</a></div>
          <div class="mobile-menu__item"><a class="mobile-menu__link" href="{{ base_path }}">{{ 'navigation.home' | t }}</a></div>
          <div class="mobile-menu__item"><a class="mobile-menu__link" href="{{ base_path }}/pages/about">{{ 'navigation.about' | t }}</a></div>
          <div class="mobile-menu__item"><a class="mobile-menu__link" href="{{ base_path }}/videos">{{ 'navigation.videos' | t }}</a></div>
          <div class="mobile-menu__item"><a class="mobile-menu__link" href="{{ base_path }}/posts">{{ 'navigation.articles' | t }}</a></div>
          <div class="mobile-menu__item"><a class="mobile-menu__link" href="{{ base_path }}/photos">{{ 'navigation.photos' | t }}</a></div>
        </div>
      </div>
    </div>
    
    <!-- Mobile language list -->
    <div class="languages__list--mobile js_lang_mobile_list">
      <div class="languages__list-inner">
        <div class="languages__list">
          <div class="languages__list-item js_close-lang-btn">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M28 2.82L25.18 0L14 11.18L2.82 0L0 2.82L11.18 14L0 25.18L2.82 28L14 16.82L25.18 28L28 25.18L16.82 14L28 2.82Z" fill="white"/>
            </svg>
          </div>
          {% for item in blog_locale_switcher_items %}
          <div class="languages__list-item">
            <a href="{{ base_path }}/locale/{{ item.path_segment }}">
              <p><span>{{ item.ui_tag }}</span><span>-</span><span>{{ item.native_name }}</span></p>
            </a>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
    
    <!-- Search popup -->
    <div class="search__popup js_search_list js__popup">
      <div class="search__inner">
        <div class="search__close-btn js_close-search-btn">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M28 2.82L25.18 0L14 11.18L2.82 0L0 2.82L11.18 14L0 25.18L2.82 28L14 16.82L25.18 28L28 25.18L16.82 14L28 2.82Z" fill="white"/>
          </svg>
        </div>
        <form action="{{ base_path }}/search" method="get">
          <div class="search__input">
            <input type="search" name="q" placeholder="{{ 'search.placeholder' | t }}">
          </div>
        </form>
        <div class="search__list">
          {% for tag in popular_tags %}
          <div class="search__list-item"><a href="{{ base_path }}/tags/{{ tag.slug }}">{{ tag.name }}</a></div>
          {% endfor %}
        </div>
      </div>
    </div>
    
    <!-- Contact popup -->
    <div class="popup-contact js__popup popup-container">
      <div class="popup popup--contact">
        <div class="popup__body">
          <div class="popup__inner">
            <div class="popup__close">
              <div class="popup__close-ico js_popup_button_close">
                <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M28 2.82L25.18 0L14 11.18L2.82 0L0 2.82L11.18 14L0 25.18L2.82 28L14 16.82L25.18 28L28 25.18L16.82 14L28 2.82Z" fill="black"/>
                </svg>
              </div>
            </div>
            <div class="popup__content row">
              <div class="popup__title">{{ 'contact.title' | t }}</div>
              <form class="popup__form" action="javascript:void(0)">
                <div class="popup__textarea">
                  <textarea class="js_validation_textarea" placeholder="{{ 'contact.message_placeholder' | t }}"></textarea>
                </div>
                <div class="popup__input">
                  <div class="popup__input-title show">{{ 'contact.name_placeholder' | t }}</div>
                  <input class="js_validation_name" type="text">
                </div>
                <div class="popup__input">
                  <input class="js_validation_email" type="email">
                  <div class="popup__input-title show">{{ 'contact.email_placeholder' | t }}</div>
                </div>
                <button class="popup__btn white contact js_submit_form" type="submit">{{ 'contact.send' | t }}</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Email subscription popup (mobile) -->
    <div class="popup-email js__popup popup-container">
      <div class="popup popup--email">
        <div class="popup__body">
          <div class="popup__inner">
            <div class="popup__close">
              <div class="popup__close-ico js_popup_button_close">
                <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M28 2.82L25.18 0L14 11.18L2.82 0L0 2.82L11.18 14L0 25.18L2.82 28L14 16.82L25.18 28L28 25.18L16.82 14L28 2.82Z" fill="black"/>
                </svg>
              </div>
            </div>
            <div class="popup__content row">
              <form class="popup__form" action="javascript:void(0)">
                <div class="popup__input">
                  <input class="js_validation_email" type="email">
                  <div class="popup__input-title contact-email">{{ 'newsletter.email_placeholder' | t }}</div>
                </div>
                <button class="popup__btn white email js_submit_form" type="submit">{{ 'newsletter.send' | t }}</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
    
  </div>
  
  <!-- Scripts -->
  <script src="/themes/am/js/libs/lazysizes.min.js" async></script>
  <script src="/themes/am/js/libs/swiper-bundle.min.js"></script>
  <script src="/themes/am/js/libs/lightgallery.umd.min.js"></script>
  <script src="/themes/am/js/libs/lg-thumbnail.umd.min.js"></script>
  <script src="/themes/am/js/libs/lg-zoom.umd.min.js"></script>
  <script src="/themes/am/js/libs/lg-share.umd.min.js"></script>
  <script src="/themes/am/js/libs/lg-pager.umd.min.js"></script>
  <script src="/themes/am/js/libs/popper.min.js"></script>
  <script src="/themes/am/js/libs/tippy-bundle.umd.min.js"></script>
  <script src="/themes/am/js/main.js"></script>
  <script src="/themes/am/js/filters.js"></script>
</body>
</html>
