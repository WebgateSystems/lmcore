<!-- 404 - Not Found -->
<div class="section-not-found">
  <div class="container-fluid container">
    <div class="section-not-found__inner">
      <p class="section-not-found__code">404</p>
      <h1 class="section-not-found__title">{{ 'errors.not_found' | t }}</h1>
      {% if not_found_message and not_found_message != blank %}
      <p class="section-not-found__message">{{ not_found_message }}</p>
      {% endif %}
      <p class="section-not-found__cta">
        <a class="btn btn--black" href="{{ base_path | default: '/' }}/">
          {{ 'errors.back_home' | t }}
        </a>
      </p>
    </div>
  </div>
</div>

<style>
  .section-not-found {
    padding: 80px 0 120px;
    text-align: center;
  }
  .section-not-found__inner {
    max-width: 640px;
    margin: 0 auto;
  }
  .section-not-found__code {
    font-family: 'Fira Sans Extra Condensed', sans-serif;
    font-weight: 800;
    font-size: 140px;
    line-height: 1;
    color: #c52a2a;
    margin: 0 0 16px;
  }
  .section-not-found__title {
    font-family: 'Fira Sans Extra Condensed', sans-serif;
    font-weight: 700;
    font-size: 36px;
    line-height: 1.2;
    margin: 0 0 16px;
    color: #000;
    text-transform: uppercase;
  }
  .section-not-found__message {
    font-size: 20px;
    line-height: 1.5;
    color: #555;
    margin: 0 0 32px;
  }
  .section-not-found__cta {
    margin-top: 24px;
  }
  .section-not-found__cta a {
    display: inline-block;
    padding: 14px 28px;
    background: #000;
    color: #fff;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.15s ease-in-out;
  }
  .section-not-found__cta a:hover,
  .section-not-found__cta a:focus {
    background: #c52a2a;
  }
  @media (max-width: 680px) {
    .section-not-found {
      padding: 48px 0 80px;
    }
    .section-not-found__code {
      font-size: 96px;
    }
    .section-not-found__title {
      font-size: 28px;
    }
    .section-not-found__message {
      font-size: 18px;
    }
  }
</style>
