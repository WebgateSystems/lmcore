<!-- Search page -->
<div class="section-articles">
  <div class="container-fluid container">
    <!-- Nagłówek i formularz wyszukiwania -->
    <div class="section-articles__title" style="margin-bottom: 40px;">
      <h1 class="article-title article-title--black">{{ 'search.title' | t }}</h1>
      
      <form action="{{ base_path }}/search" method="get" class="search-form" style="margin-top: 25px; display: flex; gap: 15px; flex-wrap: wrap; align-items: center;">
        <div style="flex: 1; min-width: 250px; position: relative;">
          <input type="text" name="q" value="{{ query }}" placeholder="{{ 'search.placeholder' | t }}" 
                 class="search-input" 
                 style="width: 100%; padding: 15px 20px; font-size: 18px; border: 2px solid #000; outline: none;">
        </div>
        
        <select name="type" class="search-type-filter" 
                style="padding: 15px 20px; font-size: 16px; border: 2px solid #000; background: #fff; min-width: 150px;">
          <option value="">{{ 'filters.type' | t }}: {{ 'content.all' | t }}</option>
          <option value="post" {% if type_filter == 'post' %}selected{% endif %}>{{ 'navigation.articles' | t }}</option>
          <option value="video" {% if type_filter == 'video' %}selected{% endif %}>{{ 'navigation.videos' | t }}</option>
          <option value="photo" {% if type_filter == 'photo' %}selected{% endif %}>{{ 'navigation.photos' | t }}</option>
        </select>
        
        <button type="submit" class="btn btn--black" 
                style="padding: 15px 30px; font-size: 16px; text-transform: uppercase; font-weight: 700;">
          {{ 'search.title' | t }}
        </button>
      </form>
    </div>
    
    <!-- Informacja o wynikach -->
    {% if query != '' %}
    <div class="search-results-info" style="margin-bottom: 30px; padding-bottom: 20px; border-bottom: 2px solid #000;">
      <p class="site-text__large-24">
        {{ 'search.results_for' | t }}: <strong>"{{ query }}"</strong>
        {% if results_count > 0 %}
        <span style="color: #959595; margin-left: 15px;">({{ results_count }} {{ 'content.materials' | t }})</span>
        {% endif %}
      </p>
    </div>
    {% endif %}
    
    <!-- Wyniki wyszukiwania -->
    {% if results.size > 0 %}
    <div class="search-results">
      {% for result in results %}
      <div class="search-result" style="display: flex; justify-content: space-between; align-items: flex-start; padding: 25px 0; border-bottom: 1px solid #e5e5e5;">
        
        <div class="search-result__content" style="flex: 1;">
          <!-- Typ materiału -->
          <div class="search-result__type" style="margin-bottom: 8px;">
            <span style="display: inline-flex; align-items: center; padding: 4px 12px; background: 
              {% if result.type == 'post' %}#000{% elsif result.type == 'video' %}#cc0000{% else %}#666{% endif %}; 
              color: #fff; font-size: 12px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">
              {% if result.type == 'post' %}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-right: 6px;">
                <path d="M19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3ZM17 17H7V15H17V17ZM17 13H7V11H17V13ZM17 9H7V7H17V9Z" fill="currentColor"/>
              </svg>
              {% elsif result.type == 'video' %}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-right: 6px;">
                <path d="M17 10.5V7C17 6.45 16.55 6 16 6H4C3.45 6 3 6.45 3 7V17C3 17.55 3.45 18 4 18H16C16.55 18 17 17.55 17 17V13.5L21 17.5V6.5L17 10.5Z" fill="currentColor"/>
              </svg>
              {% else %}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-right: 6px;">
                <path d="M21 19V5C21 3.9 20.1 3 19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19ZM8.5 13.5L11 16.51L14.5 12L19 18H5L8.5 13.5Z" fill="currentColor"/>
              </svg>
              {% endif %}
              {{ result.type_label }}
            </span>
          </div>
          
          <!-- Tytuł -->
          <a href="{{ result.url }}" class="search-result__title" style="text-decoration: none; color: #000;">
            <h3 class="site-text__bold-24" style="margin: 0 0 10px 0; transition: color 0.2s;">{{ result.title | strip_html }}</h3>
          </a>
          
          <!-- Lead/Description -->
          {% if result.lead %}
          <p class="site-text__large-18" style="color: #666; margin: 0; line-height: 1.5;">
            {{ result.lead | strip_html | truncate: 200 }}
          </p>
          {% endif %}
        </div>
        
        <!-- Meta -->
        <div class="search-result__meta" style="text-align: right; min-width: 120px; margin-left: 25px;">
          <span class="search-result__date" style="color: #959595; font-size: 14px;">{{ result.published_at }}</span>
          <div style="display: flex; justify-content: flex-end; gap: 15px; margin-top: 10px;">
            <span style="color: #959595; font-size: 14px; display: flex; align-items: center;">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-right: 4px;">
                <path d="M8 3C4.364 3 1.258 5.073 0 8C1.258 10.927 4.364 13 8 13C11.636 13 14.742 10.927 16 8C14.742 5.073 11.636 3 8 3ZM8 11.5C5.791 11.5 4 9.709 4 7.5S5.791 3.5 8 3.5 12 5.291 12 7.5 10.209 11.5 8 11.5Z" fill="#959595"/>
              </svg>
              {{ result.views_count }}
            </span>
            <span style="color: #959595; font-size: 14px; display: flex; align-items: center;">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-right: 4px;">
                <path d="M14 1H2C0.9 1 0 1.9 0 3V11C0 12.1 0.9 13 2 13H4V15.5L8.5 13H14C15.1 13 16 12.1 16 11V3C16 1.9 15.1 1 14 1Z" fill="#959595"/>
              </svg>
              {{ result.comments_count }}
            </span>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
    
    {% elsif query != '' %}
    <!-- Brak wyników -->
    <div class="no-results" style="text-align: center; padding: 80px 20px;">
      <svg width="80" height="80" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-bottom: 20px; opacity: 0.3;">
        <path d="M15.5 14H14.71L14.43 13.73C15.41 12.59 16 11.11 16 9.5C16 5.91 13.09 3 9.5 3C5.91 3 3 5.91 3 9.5C3 13.09 5.91 16 9.5 16C11.11 16 12.59 15.41 13.73 14.43L14 14.71V15.5L19 20.49L20.49 19L15.5 14ZM9.5 14C7.01 14 5 11.99 5 9.5C5 7.01 7.01 5 9.5 5C11.99 5 14 7.01 14 9.5C14 11.99 11.99 14 9.5 14Z" fill="#000"/>
      </svg>
      <p class="site-text__large-24" style="color: #959595; margin-bottom: 10px;">{{ 'search.no_results' | t }}: "{{ query }}"</p>
      <p class="site-text__medium" style="color: #aaa;">{{ 'search.try_different' | t }}</p>
    </div>
    {% else %}
    <!-- Stan początkowy - zachęta do wyszukiwania -->
    <div class="search-hint" style="text-align: center; padding: 80px 20px;">
      <svg width="80" height="80" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-bottom: 20px; opacity: 0.2;">
        <path d="M15.5 14H14.71L14.43 13.73C15.41 12.59 16 11.11 16 9.5C16 5.91 13.09 3 9.5 3C5.91 3 3 5.91 3 9.5C3 13.09 5.91 16 9.5 16C11.11 16 12.59 15.41 13.73 14.43L14 14.71V15.5L19 20.49L20.49 19L15.5 14ZM9.5 14C7.01 14 5 11.99 5 9.5C5 7.01 7.01 5 9.5 5C11.99 5 14 7.01 14 9.5C14 11.99 11.99 14 9.5 14Z" fill="#000"/>
      </svg>
      <p class="site-text__large-24" style="color: #959595;">{{ 'search.enter_query' | t }}</p>
    </div>
    {% endif %}
  </div>
</div>

<style>
.search-result__title:hover h3 {
  color: #cc0000 !important;
}

.search-input:focus {
  border-color: #cc0000;
}

mark {
  background-color: #ffeb3b;
  padding: 0 2px;
}

@media (max-width: 768px) {
  .search-form {
    flex-direction: column;
  }
  
  .search-form > * {
    width: 100% !important;
    min-width: unset !important;
  }
  
  .search-result {
    flex-direction: column !important;
  }
  
  .search-result__meta {
    text-align: left !important;
    margin-left: 0 !important;
    margin-top: 15px !important;
  }
  
  .search-result__meta > div {
    justify-content: flex-start !important;
  }
}
</style>
